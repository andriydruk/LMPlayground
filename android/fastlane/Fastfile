default_platform(:android)

platform :android do
  desc "Upload release AAB + changelog to internal track"
  lane :deploy_internal do
    upload_to_play_store(
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
      # changelogs (whatsnew) are uploaded by default from fastlane/metadata/android/*/changelogs
    )
  end

  desc "Sync Play Store listing (title, descriptions, screenshots) — no binary"
  lane :update_listing do
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true
    )
  end
end
