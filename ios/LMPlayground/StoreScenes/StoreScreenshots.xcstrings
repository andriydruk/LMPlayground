    "screenshot_system_prompt_sample": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت معلّم علوم مختصر. اشرح الأفكار بوضوح مع أمثلة من الحياة اليومية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি একজন সংক্ষিপ্ত বিজ্ঞান শিক্ষক। দৈনন্দিন উদাহরণ দিয়ে ধারণাগুলি স্পষ্টভাবে ব্যাখ্যা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste stručný učitel přírodních věd. Vysvětlujte myšlenky jasně pomocí každodenních příkladů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er en kortfattet naturvidenskabslærer. Forklar idéer tydeligt med hverdagseksempler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist ein präziser Wissenschaftslehrer. Erkläre Ideen klar mit Beispielen aus dem Alltag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a concise science tutor. Explain ideas clearly with everyday examples."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres un tutor de ciencias conciso. Explica las ideas con claridad usando ejemplos cotidianos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet tiivis tiedeopettaja. Selitä ajatukset selkeästi arkipäiväisin esimerkein."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikaw ay isang maikling tagapagturo ng agham. Ipaliwanag ang mga ideya nang malinaw gamit ang mga halimbawa sa pang-araw-araw na buhay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es un tuteur scientifique concis. Explique les idées clairement avec des exemples du quotidien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה מורה תמציתי למדעים. הסבר רעיונות בבהירות בעזרת דוגמאות מחיי היום-יום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप एक संक्षिप्त विज्ञान शिक्षक हैं। रोजमर्रा के उदाहरणों के साथ विचारों को स्पष्ट रूप से समझाएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu adalah tutor sains yang ringkas. Jelaskan ide dengan jernih lewat contoh sehari-hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei un tutor di scienze conciso. Spiega le idee con chiarezza usando esempi quotidiani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは簡潔な科学の先生です。身近な例を使ってアイデアをわかりやすく説明してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 간결한 과학 튜터입니다. 일상적인 예시를 들어 아이디어를 명확하게 설명하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda adalah tutor sains yang ringkas. Terangkan idea dengan jelas menggunakan contoh harian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er en konsis vitenskapslærer. Forklar ideer tydelig med hverdagslige eksempler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent een bondige wetenschapsleraar. Leg ideeën helder uit met alledaagse voorbeelden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś zwięzłym korepetytorem nauk ścisłych. Tłumacz pojęcia jasno, posługując się codziennymi przykładami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é um tutor de ciências objetivo. Explique ideias com clareza usando exemplos do dia a dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ești un profesor de științe concis. Explică ideile clar, cu exemple din viața de zi cu zi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är en koncis vetenskapslärare. Förklara idéer tydligt med vardagliga exempel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเป็นติวเตอร์วิทยาศาสตร์ที่กระชับ อธิบายแนวคิดให้ชัดเจนด้วยตัวอย่างในชีวิตประจำวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen kısa ve öz bir fen öğretmenisin. Fikirleri günlük hayattan örneklerle açıkça açıkla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти лаконічний викладач природничих наук. Пояснюй ідеї зрозуміло, використовуючи приклади з повсякденного життя."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn là một gia sư khoa học ngắn gọn. Hãy giải thích các ý tưởng một cách rõ ràng bằng những ví dụ thường ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是一位简洁的科学老师。请用日常生活中的例子清晰地解释概念。"
          }
        }
      }
    },
