    "screenshot_prompts_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط النبرة مرة واحدة واستخدمها في كل مكان"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবার টোন ঠিক করুন, যেকোনো জায়গায় ব্যবহার করুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "nastavte tón jednou, používejte kdekoli"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "sæt tonen én gang, brug den overalt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonfall einmal festlegen, überall nutzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "set the tone once, use anywhere"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "define el tono una vez, úsalo donde quieras"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "aseta sävy kerran, käytä missä tahansa"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "itakda ang tono nang minsan, gamitin saanman"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "définissez le ton une fois, utilisez-le partout"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדירו את הטון פעם אחת, השתמשו בכל מקום"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार टोन तय करें, हर जगह इस्तेमाल करें"
          }
        },
        "id": {
          "stringUnit": {
