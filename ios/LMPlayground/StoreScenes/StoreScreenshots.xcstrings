    "screenshot_documents_response": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الإنهاء بـ **إشعار خطي مدته 60 يومًا** بعد فترة الأشهر الستة الأولى. يُعاد مبلغ التأمين خلال 14 يومًا من مغادرة السكن (القسم 8.2)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথম ছয় মাস মেয়াদের পরে আপনি **৬০ দিনের লিখিত নোটিশে** বাতিল করতে পারেন। বাড়ি ছাড়ার ১৪ দিনের মধ্যে আপনার জামানত ফেরত দেওয়া হয় (ধারা 8.2)।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smlouvu můžete vypovědět s **60denní písemnou výpovědní lhůtou** po úvodním šestiměsíčním období. Kauce se vrací do 14 dnů od vystěhování (Oddíl 8.2)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan opsige med **60 dages skriftligt varsel** efter den indledende seksmånedersperiode. Dit depositum tilbagebetales inden for 14 dage efter fraflytning (Afsnit 8.2)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst mit einer **schriftlichen Frist von 60 Tagen** nach den ersten sechs Monaten kündigen. Deine Kaution wird innerhalb von 14 Tagen nach dem Auszug zurückerstattet (Abschnitt 8.2)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can terminate with **60 days' written notice** after the initial six-month period. Your deposit is returned within 14 days of move-out (Section 8.2)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes rescindir con **60 días de preaviso por escrito** tras el periodo inicial de seis meses. Tu depósito se devuelve en un plazo de 14 días desde la mudanza (Sección 8.2)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit irtisanoa **60 päivän kirjallisella irtisanomisajalla** ensimmäisen kuuden kuukauden jakson jälkeen. Vakuutesi palautetaan 14 päivän kuluessa muutosta (Kohta 8.2)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede kang magtapos nang may **60 araw na nakasulat na abiso** pagkatapos ng unang anim na buwan. Ibabalik ang iyong deposito sa loob ng 14 araw pagkatapos lumipat (Seksyon 8.2)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez résilier avec un **préavis écrit de 60 jours** après la période initiale de six mois. Votre caution est restituée dans les 14 jours suivant le départ (Section 8.2)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לסיים ב**הודעה בכתב של 60 יום** לאחר תקופת ששת החודשים הראשונה. הפיקדון מוחזר תוך 14 יום מהפינוי (סעיף 8.2)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरुआती छह महीने की अवधि के बाद आप **60 दिन के लिखित नोटिस** के साथ समाप्त कर सकते हैं. आपकी जमा राशि मकान खाली करने के 14 दिनों के भीतर लौटा दी जाती है (धारा 8.2)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat mengakhiri dengan **pemberitahuan tertulis 60 hari** setelah periode enam bulan awal. Deposit Anda dikembalikan dalam 14 hari setelah pindah (Bagian 8.2)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi disdire con un **preavviso scritto di 60 giorni** dopo il periodo iniziale di sei mesi. Il deposito viene restituito entro 14 giorni dal trasloco (Sezione 8.2)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の6か月間の後、**60日前の書面による通知**で解約できます。敷金は退去後14日以内に返還されます（第8.2条）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최초 6개월 기간이 지난 후 **60일 전 서면 통지**로 해지할 수 있습니다. 보증금은 퇴거 후 14일 이내에 반환됩니다(8.2항)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menamatkan dengan **notis bertulis 60 hari** selepas tempoh enam bulan pertama. Deposit anda dikembalikan dalam masa 14 hari selepas berpindah keluar (Seksyen 8.2)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan si opp med **60 dagers skriftlig varsel** etter den første seksmånedersperioden. Depositumet ditt tilbakebetales innen 14 dager etter utflytting (Avsnitt 8.2)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt opzeggen met **60 dagen schriftelijke opzegtermijn** na de eerste zes maanden. Je borg wordt binnen 14 dagen na vertrek terugbetaald (Paragraaf 8.2)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz wypowiedzieć umowę z **60-dniowym pisemnym wypowiedzeniem** po początkowym okresie sześciu miesięcy. Kaucja jest zwracana w ciągu 14 dni od wyprowadzki (Sekcja 8.2)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode rescindir com **aviso prévio por escrito de 60 dias** após o período inicial de seis meses. Seu depósito é devolvido em até 14 dias após a saída (Seção 8.2)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți rezilia cu un **preaviz scris de 60 de zile** după perioada inițială de șase luni. Garanția se returnează în termen de 14 zile de la mutare (Secțiunea 8.2)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan säga upp med **60 dagars skriftlig uppsägningstid** efter den inledande sexmånadersperioden. Din deposition återbetalas inom 14 dagar efter utflytt (Avsnitt 8.2)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถยกเลิกได้โดย **แจ้งเป็นลายลักษณ์อักษรล่วงหน้า 60 วัน** หลังจากช่วงหกเดือนแรก เงินมัดจำจะคืนภายใน 14 วันหลังย้ายออก (ข้อ 8.2)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk altı aylık dönemin ardından **60 gün önceden yazılı bildirimle** feshedebilirsiniz. Depozitonuz taşınmadan sonra 14 gün içinde iade edilir (Bölüm 8.2)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете розірвати договір із **письмовим повідомленням за 60 днів** після початкового шестимісячного періоду. Заставу повертають протягом 14 днів після виїзду (Розділ 8.2)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể chấm dứt bằng **thông báo trước 60 ngày bằng văn bản** sau giai đoạn sáu tháng đầu. Tiền đặt cọc được hoàn lại trong vòng 14 ngày sau khi dọn đi (Mục 8.2)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在最初六个月期满后，你可以提前 **60 天书面通知**终止合同。押金会在退租后 14 天内退还（第 8.2 节）。"
          }
        }
      }
    },
