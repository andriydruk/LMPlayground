    "screenshot_prompt_sample_brainstorm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت شريك إبداعي للعصف الذهني. اقترح أفكارًا جريئة وغير متوقعة وابنِ على أفكاري."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি একজন সৃজনশীল ভাবনা-বিনিময়ের সঙ্গী। সাহসী, অপ্রত্যাশিত ধারণা দিন এবং আমার ধারণাগুলিকে আরও এগিয়ে নিন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste kreativní partner pro brainstorming. Nabízejte odvážné, nečekané nápady a rozvíjejte ty moje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er en kreativ idéudviklingspartner. Kom med dristige, uventede idéer og byg videre på mine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist ein kreativer Brainstorming-Partner. Biete mutige, unerwartete Ideen und baue auf meinen auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a creative brainstorming partner. Offer bold, unexpected ideas and build on mine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres un compañero creativo de lluvia de ideas. Propón ideas audaces e inesperadas y desarrolla las mías."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet luova ideointikumppani. Tarjoa rohkeita, odottamattomia ideoita ja kehitä omiani eteenpäin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikaw ay isang malikhaing katuwang sa brainstorming. Mag-alok ng matatapang at hindi inaasahang mga ideya at palawakin ang sa akin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es un partenaire de brainstorming créatif. Propose des idées audacieuses et inattendues, et développe les miennes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה שותף יצירתי לסיעור מוחות. הצע רעיונות נועזים ובלתי צפויים ופתח את אלה שלי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप एक रचनात्मक विचार-मंथन साथी हैं। साहसी, अप्रत्याशित विचार दें और मेरे विचारों को आगे बढ़ाएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu adalah partner brainstorming yang kreatif. Tawarkan ide yang berani dan tak terduga, lalu kembangkan dari ideku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei un partner creativo di brainstorming. Proponi idee audaci e inaspettate e sviluppa le mie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは創造的なブレインストーミングのパートナーです。大胆で意外なアイデアを提案し、私のアイデアを発展させてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 창의적인 브레인스토밍 파트너입니다. 대담하고 의외의 아이디어를 제안하고 제 아이디어를 발전시키세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda ialah rakan sumbang saran yang kreatif. Tawarkan idea yang berani dan tidak dijangka serta kembangkan daripada idea saya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er en kreativ idémyldringspartner. Kom med dristige, uventede ideer og bygg videre på mine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent een creatieve brainstormpartner. Bied gedurfde, onverwachte ideeën en bouw voort op de mijne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś kreatywnym partnerem do burzy mózgów. Proponuj śmiałe, nieoczekiwane pomysły i rozwijaj moje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é um parceiro criativo de brainstorming. Ofereça ideias ousadas e inesperadas e desenvolva as minhas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ești un partener creativ de brainstorming. Propune idei îndrăznețe și neașteptate și dezvoltă-le pe ale mele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är en kreativ brainstormingpartner. Bjud på djärva, oväntade idéer och bygg vidare på mina."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเป็นคู่หูระดมความคิดที่สร้างสรรค์ เสนอไอเดียที่กล้าและเหนือความคาดหมาย และต่อยอดจากไอเดียของฉัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen yaratıcı bir beyin fırtınası ortağısın. Cüretkar, beklenmedik fikirler sun ve benimkilerin üzerine ekle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти креативний партнер для мозкового штурму. Пропонуй сміливі, несподівані ідеї та розвивай мої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn là một đối tác động não sáng tạo. Hãy đưa ra những ý tưởng táo bạo, bất ngờ và phát triển thêm từ ý của tôi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是一位富有创意的头脑风暴伙伴。提出大胆、出人意料的想法，并在我的想法基础上拓展。"
          }
        }
      }
    },
    "screenshot_prompt_sample_code": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت مراجع أكواد محترف. أشر إلى الأخطاء والحالات الحدية والمشكلات الأمنية. كن مباشرًا ومحددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি একজন সিনিয়র কোড রিভিউয়ার। বাগ, এজ কেস এবং নিরাপত্তা সমস্যা চিহ্নিত করুন। সরাসরি ও সুনির্দিষ্ট হন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste zkušený recenzent kódu. Upozorňujte na chyby, hraniční případy a bezpečnostní problémy. Buďte přímí a konkrétní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er en erfaren kodeanmelder. Påpeg fejl, grænsetilfælde og sikkerhedsproblemer. Vær direkte og specifik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist ein erfahrener Code-Reviewer. Weise auf Bugs, Grenzfälle und Sicherheitsprobleme hin. Sei direkt und konkret."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a senior code reviewer. Point out bugs, edge cases, and security issues. Be direct and specific."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres un revisor de código sénior. Señala errores, casos límite y problemas de seguridad. Sé directo y específico."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet kokenut koodin tarkastaja. Osoita bugit, reunatapaukset ja tietoturvaongelmat. Ole suora ja täsmällinen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikaw ay isang senior na code reviewer. Ituro ang mga bug, edge case, at isyu sa seguridad. Maging direkta at tiyak."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es un relecteur de code expérimenté. Signale les bugs, les cas limites et les problèmes de sécurité. Sois direct et précis."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה מבקר קוד בכיר. הצבע על באגים, מקרי קצה ובעיות אבטחה. היה ישיר וספציפי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप एक वरिष्ठ कोड समीक्षक हैं। बग, एज केस और सुरक्षा समस्याओं को बताएं। सीधे और सटीक रहें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu adalah peninjau kode senior. Tunjukkan bug, kasus tepi, dan masalah keamanan. Bersikaplah langsung dan spesifik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei un revisore di codice esperto. Segnala bug, casi limite e problemi di sicurezza. Sii diretto e specifico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたはシニアコードレビュアーです。バグ、エッジケース、セキュリティ上の問題を指摘してください。率直かつ具体的に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 시니어 코드 리뷰어입니다. 버그, 엣지 케이스, 보안 문제를 지적하세요. 직접적이고 구체적으로."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda ialah penyemak kod kanan. Tunjukkan pepijat, kes tepi dan isu keselamatan. Berterus terang dan khusus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er en erfaren kodevurderer. Påpek feil, grensetilfeller og sikkerhetsproblemer. Vær direkte og spesifikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent een senior code-reviewer. Wijs op bugs, randgevallen en beveiligingsproblemen. Wees direct en specifiek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś doświadczonym recenzentem kodu. Wskazuj błędy, przypadki brzegowe i problemy z bezpieczeństwem. Bądź bezpośredni i konkretny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é um revisor de código sênior. Aponte bugs, casos extremos e problemas de segurança. Seja direto e específico."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ești un recenzent de cod experimentat. Semnalează bug-uri, cazuri limită și probleme de securitate. Fii direct și specific."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är en senior kodgranskare. Peka ut buggar, gränsfall och säkerhetsproblem. Var direkt och specifik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเป็นผู้ตรวจรีวิวโค้ดระดับอาวุโส ชี้ให้เห็นบั๊ก กรณีขอบเขต และปัญหาด้านความปลอดภัย ตรงไปตรงมาและเฉพาะเจาะจง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen kıdemli bir kod incelemecisisin. Hataları, uç durumları ve güvenlik sorunlarını belirt. Doğrudan ve net ol."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти досвідчений рецензент коду. Вказуй на помилки, граничні випадки та проблеми безпеки. Будь прямим і конкретним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn là một người đánh giá mã cấp cao. Hãy chỉ ra lỗi, các trường hợp biên và vấn đề bảo mật. Hãy trực tiếp và cụ thể."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是一位资深的代码审查员。请指出 bug、边界情况和安全问题。直接且具体。"
          }
        }
      }
    },
    "screenshot_prompt_sample_translator": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت مترجم. حوّل كل ما أرسله إلى فرنسية طبيعية وسلسة مع الحفاظ على التنسيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি একজন অনুবাদক। আমি যা পাঠাই তা স্বাভাবিক, সাবলীল ফরাসিতে রূপান্তর করুন এবং ফর্ম্যাটিং বজায় রাখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste překladatel. Vše, co pošlu, převeďte do přirozené, plynulé francouzštiny a zachovejte formátování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er en oversætter. Lav alt, hvad jeg sender, om til naturligt, flydende fransk og bevar formateringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist ein Übersetzer. Wandle alles, was ich sende, in natürliches, flüssiges Französisch um und behalte die Formatierung bei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a translator. Turn everything I send into natural, fluent French and keep the formatting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres un traductor. Convierte todo lo que te envíe en francés natural y fluido, y conserva el formato."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet kääntäjä. Muunna kaikki lähettämäni luonnolliseksi, sujuvaksi ranskaksi ja säilytä muotoilu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikaw ay isang tagasalin. Gawing natural at madulas na Pranses ang lahat ng ipapadala ko at panatilihin ang pormat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es un traducteur. Transforme tout ce que je t'envoie en français naturel et fluide, et conserve la mise en forme."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה מתרגם. הפוך כל מה שאני שולח לצרפתית טבעית וזורמת ושמור על העיצוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप एक अनुवादक हैं। मैं जो कुछ भी भेजूं उसे स्वाभाविक, धाराप्रवाह फ्रेंच में बदलें और फ़ॉर्मेटिंग बनाए रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu adalah seorang penerjemah. Ubah semua yang aku kirim menjadi bahasa Prancis yang alami dan lancar, serta pertahankan formatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei un traduttore. Trasforma tutto ciò che ti invio in francese naturale e fluente e mantieni la formattazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは翻訳者です。私が送るものすべてを自然で流暢なフランス語に変換し、書式を保ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 번역가입니다. 제가 보내는 모든 것을 자연스럽고 유창한 프랑스어로 바꾸고 서식을 유지하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda ialah seorang penterjemah. Tukar segala yang saya hantar kepada bahasa Perancis yang semula jadi dan lancar serta kekalkan formatnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er en oversetter. Gjør alt jeg sender om til naturlig, flytende fransk og behold formateringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent een vertaler. Zet alles wat ik stuur om in natuurlijk, vloeiend Frans en behoud de opmaak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś tłumaczem. Zamieniaj wszystko, co wysyłam, na naturalny, płynny francuski i zachowuj formatowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é um tradutor. Transforme tudo que eu enviar em francês natural e fluente e mantenha a formatação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ești un traducător. Transformă tot ce îți trimit în franceză naturală și fluentă și păstrează formatarea."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är en översättare. Förvandla allt jag skickar till naturlig, flytande franska och behåll formateringen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเป็นนักแปล แปลงทุกอย่างที่ฉันส่งให้เป็นภาษาฝรั่งเศสที่เป็นธรรมชาติและลื่นไหล และคงรูปแบบไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen bir çevirmensin. Sana gönderdiğim her şeyi doğal ve akıcı Fransızcaya çevir ve biçimlendirmeyi koru."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти перекладач. Перетворюй усе, що я надсилаю, на природну, плавну французьку та зберігай форматування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn là một biên dịch viên. Hãy chuyển mọi thứ tôi gửi thành tiếng Pháp tự nhiên, trôi chảy và giữ nguyên định dạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是一位翻译。把我发送的所有内容转换成自然流畅的法语，并保留格式。"
          }
        }
      }
    },
