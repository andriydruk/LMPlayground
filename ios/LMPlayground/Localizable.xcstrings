    "Models are several gigabytes. Files you put in On My iPhone › LM Playground › Models also appear here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبلغ حجم النماذج عدة غيغابايت. تظهر هنا أيضًا الملفات التي تضعها في «على الـ iPhone» › LM Playground › Models."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মডেলগুলো কয়েক গিগাবাইটের। On My iPhone › LM Playground › Models-এ রাখা ফাইলও এখানে দেখা যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Modely mají několik gigabajtů. Zobrazí se tu i soubory, které umístíte do Na mém iPhonu › LM Playground › Models."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeller fylder flere gigabyte. Filer, du lægger i På min iPhone › LM Playground › Models, vises også her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle sind mehrere Gigabyte groß. Dateien, die du unter „Auf meinem iPhone“ › LM Playground › Models ablegst, erscheinen ebenfalls hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos ocupan varios gigabytes. Los archivos que pongas en En mi iPhone › LM Playground › Models también aparecen aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mallit ovat useita gigatavuja. Myös tiedostot, jotka laitat kohteeseen iPhonessa › LM Playground › Models, näkyvät täällä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilang gigabyte ang mga modelo. Lalabas din dito ang mga file na inilagay mo sa On My iPhone › LM Playground › Models."
          }
        },
        "fr": {
