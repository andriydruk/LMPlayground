    "Does a reply keep going when I leave the app?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يستمر الرد عند مغادرة التطبيق؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ থেকে বের হলে কি উত্তর চলতে থাকে?"
