    "Pick one from the menu at the top, or download one in Models.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر واحدًا من القائمة في الأعلى، أو نزّل واحدًا من النماذج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওপরের মেনু থেকে একটি বেছে নিন, অথবা মডেল থেকে একটি ডাউনলোড করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte jeden v nabídce nahoře nebo si ho stáhněte v Modelech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en i menuen øverst, eller download en under Modeller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle oben eines aus dem Menü oder lade eines unter „Modelle“ herunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige uno en el menú de arriba o descarga uno en Modelos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse malli yläreunan valikosta tai lataa se Mallit-kohdassa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili mula sa menu sa itaas, o mag-download sa Mga Modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez-en un dans le menu en haut ou téléchargez-en un dans Modèles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו מודל מהתפריט למעלה, או הורידו אחד במודלים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर दिए मेन्यू से कोई चुनें या मॉडल में जाकर डाउनलोड करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih dari menu di atas, atau unduh di Model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegline uno dal menu in alto o scaricane uno in Modelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部のメニューから選ぶか、「モデル」でダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상단 메뉴에서 선택하거나 모델에서 다운로드하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih satu daripada menu di atas, atau muat turun satu dalam Model."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en fra menyen øverst, eller last ned en under Modeller."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies er een in het menu bovenaan of download er een in Modellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz model z menu u góry lub pobierz go w sekcji Modele."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um no menu no topo ou baixe um em Modelos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege unul din meniul de sus sau descarcă unul din Modele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en i menyn högst upp eller ladda ned en under Modeller."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกจากเมนูด้านบน หรือดาวน์โหลดในส่วนโมเดล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üstteki menüden birini seç veya Modeller'den bir tane indir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть модель у меню вгорі або завантажте її в розділі «Моделі»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn từ menu phía trên hoặc tải xuống trong Mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从顶部菜单中选择一个，或在“模型”中下载。"
          }
        }
      }
    },
