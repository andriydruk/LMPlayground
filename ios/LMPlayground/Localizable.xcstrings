    "Searches DuckDuckGo. Your query leaves the device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبحث في DuckDuckGo. يخرج استعلامك من الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "DuckDuckGo-তে অনুসন্ধান করে। আপনার প্রশ্ন ডিভাইসের বাইরে যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledává na DuckDuckGo. Váš dotaz opustí zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søger via DuckDuckGo. Din søgning forlader enheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht bei DuckDuckGo. Deine Suchanfrage verlässt das Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en DuckDuckGo. Tu consulta sale del dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakee DuckDuckGosta. Hakusi lähtee laitteelta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naghahanap sa DuckDuckGo. Lalabas sa device ang iyong query."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche sur DuckDuckGo. Votre requête quitte l’appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחפש ב־DuckDuckGo. השאילתה שלכם יוצאת מהמכשיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DuckDuckGo पर खोजता है। आपकी क्वेरी डिवाइस से बाहर जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari di DuckDuckGo. Kueri Anda dikirim keluar dari perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca su DuckDuckGo. La tua ricerca lascia il dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DuckDuckGo で検索します。検索語はデバイスの外に送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DuckDuckGo에서 검색합니다. 검색어가 기기 밖으로 전송됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari di DuckDuckGo. Pertanyaan anda keluar dari peranti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søker med DuckDuckGo. Søket ditt forlater enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoekt via DuckDuckGo. Je zoekopdracht verlaat het apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukuje w DuckDuckGo. Twoje zapytanie opuszcza urządzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquisa no DuckDuckGo. Sua consulta sai do dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caută pe DuckDuckGo. Interogarea ta părăsește dispozitivul."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Söker med DuckDuckGo. Din sökfråga lämnar enheten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาด้วย DuckDuckGo คำค้นของคุณจะถูกส่งออกจากอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DuckDuckGo'da arar. Sorgun cihazdan dışarı gönderilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукає в DuckDuckGo. Ваш запит залишає пристрій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm trên DuckDuckGo. Truy vấn của bạn được gửi ra khỏi thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 DuckDuckGo 搜索。你的查询会离开设备。"
          }
        }
      }
    },
