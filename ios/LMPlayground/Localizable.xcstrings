      }
    },
    "Answering questions about documents needs a small embedding model, %@ (%@), downloaded once and kept on your device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب الرد على الأسئلة حول المستندات نموذج تضمين صغيرًا، %1$@ (%2$@)، يُنزَّل مرة واحدة ويُحفظ على جهازك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নথি সম্পর্কে প্রশ্নের উত্তর দিতে একটি ছোট এমবেডিং মডেল %1$@ (%2$@) প্রয়োজন, যা একবার ডাউনলোড হয়ে আপনার ডিভাইসে রাখা হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídání na dotazy k dokumentům vyžaduje malý model embeddingů, %1$@ (%2$@), který se jednou stáhne a zůstane ve vašem zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at svare på spørgsmål om dokumenter kræves en lille embedding-model, %1$@ (%2$@), der downloades én gang og gemmes på din enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Fragen zu Dokumenten wird ein kleines Embedding-Modell benötigt, %1$@ (%2$@), das einmal heruntergeladen und auf deinem Gerät gespeichert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para responder preguntas sobre documentos se necesita un pequeño modelo de embeddings, %1$@ (%2$@), que se descarga una vez y se guarda en tu dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asiakirjoja koskeviin kysymyksiin vastaaminen edellyttää pientä upotusmallia, %1$@ (%2$@), joka ladataan kerran ja säilytetään laitteellasi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pagsagot sa mga tanong tungkol sa mga dokumento ay nangangailangan ng maliit na embedding model, %1$@ (%2$@), na ida-download nang isang beses at itatago sa iyong device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondre à des questions sur des documents nécessite un petit modèle d'embeddings, %1$@ (%2$@), téléchargé une fois et conservé sur votre appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מענה על שאלות לגבי מסמכים דורש מודל embedding קטן, %1$@ (%2$@), שיורד פעם אחת ונשמר במכשיר שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दस्तावेज़ों के बारे में सवालों के जवाब देने के लिए एक छोटे एम्बेडिंग मॉडल %1$@ (%2$@) की ज़रूरत होती है, जो एक बार डाउनलोड होकर आपके डिवाइस पर रहता है."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjawab pertanyaan tentang dokumen memerlukan model embedding kecil, %1$@ (%2$@), yang diunduh sekali dan disimpan di perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per rispondere a domande sui documenti serve un piccolo modello di embedding, %1$@ (%2$@), scaricato una volta e conservato sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドキュメントに関する質問に答えるには、小さな埋め込みモデル %1$@（%2$@）が必要です。一度だけダウンロードされ、デバイスに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서에 대한 질문에 답하려면 작은 임베딩 모델 %1$@(%2$@)이(가) 필요합니다. 한 번 다운로드되어 기기에 저장됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjawab soalan tentang dokumen memerlukan model embedding kecil, %1$@ (%2$@), yang dimuat turun sekali dan disimpan pada peranti anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å svare på spørsmål om dokumenter trengs en liten embedding-modell, %1$@ (%2$@), som lastes ned én gang og lagres på enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor het beantwoorden van vragen over documenten is een klein embeddingmodel nodig, %1$@ (%2$@), dat één keer wordt gedownload en op je apparaat blijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadanie na pytania o dokumenty wymaga małego modelu osadzeń, %1$@ (%2$@), pobieranego raz i przechowywanego na urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder perguntas sobre documentos exige um pequeno modelo de embeddings, %1$@ (%2$@), baixado uma vez e mantido no seu dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a răspunde la întrebări despre documente este nevoie de un model mic de embedding, %1$@ (%2$@), descărcat o singură dată și păstrat pe dispozitiv."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att svara på frågor om dokument krävs en liten embedding-modell, %1$@ (%2$@), som laddas ner en gång och sparas på din enhet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตอบคำถามเกี่ยวกับเอกสารต้องใช้โมเดล embedding ขนาดเล็ก %1$@ (%2$@) ซึ่งดาวน์โหลดครั้งเดียวและเก็บไว้ในอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgelerle ilgili soruları yanıtlamak için küçük bir yerleştirme modeli, %1$@ (%2$@), gerekir; bir kez indirilir ve cihazınızda saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб відповідати на запитання про документи, потрібна невелика модель ембедингів, %1$@ (%2$@), яка завантажується один раз і зберігається на вашому пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc trả lời câu hỏi về tài liệu cần một mô hình embedding nhỏ, %1$@ (%2$@), được tải một lần và lưu trên thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答关于文档的问题需要一个小型嵌入模型 %1$@（%2$@），只需下载一次并保存在你的设备上。"
          }
        }
      }
    },
    "As the developer of LM Playground, I reserve the right to update this Privacy Policy at any time. Any changes will be effective immediately upon posting the updated policy. Users are encouraged to review this page periodically and stay informed about how their privacy is protected.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بصفتي مطوّر LM Playground، أحتفظ بالحق في تحديث سياسة الخصوصية هذه في أي وقت. ستصبح أي تغييرات سارية المفعول فور نشر السياسة المحدّثة. يُشجَّع المستخدمون على مراجعة هذه الصفحة بشكل دوري والبقاء على علم بكيفية حماية خصوصيتهم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Playground-এর ডেভেলপার হিসেবে, আমি যেকোনো সময় এই গোপনীয়তা নীতি আপডেট করার অধিকার সংরক্ষণ করি। আপডেট করা নীতি পোস্ট করার সাথে সাথেই যেকোনো পরিবর্তন কার্যকর হবে। ব্যবহারকারীদের নিয়মিত এই পৃষ্ঠাটি পর্যালোচনা করতে এবং তাদের গোপনীয়তা কীভাবে সুরক্ষিত তা সম্পর্কে অবগত থাকতে উৎসাহিত করা হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako vývojář LM Playground si vyhrazuji právo kdykoli tyto zásady ochrany osobních údajů aktualizovat. Jakékoli změny jsou účinné okamžitě po zveřejnění aktualizovaných zásad. Uživatelé jsou vybízeni, aby tuto stránku pravidelně kontrolovali a zůstali informováni o tom, jak je chráněno jejich soukromí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Som udvikler af LM Playground forbeholder jeg mig retten til at opdatere denne privatlivspolitik til enhver tid. Eventuelle ændringer træder i kraft umiddelbart efter offentliggørelsen af den opdaterede politik. Brugere opfordres til at gennemgå denne side jævnligt og holde sig informeret om, hvordan deres privatliv beskyttes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Entwickler von LM Playground behalte ich mir das Recht vor, diese Datenschutzrichtlinie jederzeit zu aktualisieren. Änderungen werden sofort nach Veröffentlichung der aktualisierten Richtlinie wirksam. Nutzer werden ermutigt, diese Seite regelmäßig zu überprüfen und sich darüber zu informieren, wie ihre Privatsphäre geschützt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como desarrollador de LM Playground, me reservo el derecho de actualizar esta Política de Privacidad en cualquier momento. Cualquier cambio será efectivo inmediatamente después de publicar la política actualizada. Se recomienda a los usuarios revisar esta página periódicamente y mantenerse informados sobre cómo se protege su privacidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Playgroundin kehittäjänä pidätän oikeuden päivittää tätä tietosuojakäytäntöä milloin tahansa. Muutokset tulevat voimaan välittömästi, kun päivitetty käytäntö julkaistaan. Käyttäjiä kannustetaan tarkistamaan tämä sivu säännöllisesti ja pysymään ajan tasalla siitä, miten yksityisyyttäsi suojataan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilang developer ng LM Playground, nagkakaroon ako ng karapatang i-update ang Patakaran sa Privacy na ito anumang oras. Ang anumang pagbabago ay magkakabisa kaagad pagkatapos mai-post ang na-update na patakaran. Hinihikayat ang mga user na suriin ang pahinang ito paminsan-minsan at manatiling may kaalaman kung paano protektado ang kanilang privacy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En tant que développeur de LM Playground, je me réserve le droit de mettre à jour cette Politique de Confidentialité à tout moment. Tout changement sera effectif immédiatement après la publication de la politique mise à jour. Les utilisateurs sont encouragés à consulter cette page régulièrement et à rester informés sur la manière dont leur vie privée est protégée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמפתח של LM Playground, אני שומר לעצמי את הזכות לעדכן מדיניות פרטיות זו בכל עת. כל שינוי ייכנס לתוקף מיד עם פרסום המדיניות המעודכנת. משתמשים מתבקשים לבדוק דף זה מעת לעת ולהתעדכן כיצד הפרטיות שלהם מוגנת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Playground के डेवलपर के रूप में, मैं किसी भी समय इस गोपनीयता नीति को अपडेट करने का अधिकार सुरक्षित रखता हूं। कोई भी परिवर्तन अपडेट की गई नीति पोस्ट करने के तुरंत बाद प्रभावी होगा। उपयोगकर्ताओं को इस पृष्ठ को समय-समय पर देखने और यह जानने के लिए प्रोत्साहित किया जाता है कि उनकी गोपनीयता कैसे सुरक्षित है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagai pengembang LM Playground, saya berhak memperbarui Kebijakan Privasi ini kapan saja. Setiap perubahan akan berlaku segera setelah kebijakan yang diperbarui dipublikasikan. Pengguna dianjurkan untuk meninjau halaman ini secara berkala dan tetap mendapat informasi tentang bagaimana privasi mereka dilindungi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come sviluppatore di LM Playground, mi riservo il diritto di aggiornare questa Informativa sulla Privacy in qualsiasi momento. Qualsiasi modifica sarà effettiva immediatamente dopo la pubblicazione dell'informativa aggiornata. Gli utenti sono incoraggiati a controllare questa pagina periodicamente e a rimanere informati su come viene protetta la loro privacy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Playground の開発者として、本プライバシーポリシーをいつでも更新する権利を留保します。変更は、このページに更新されたポリシーを掲載した時点で直ちに有効となります。ユーザーの皆様には、このページを定期的にご確認いただき、プライバシーがどのように保護されているかを把握していただくことをお勧めします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Playground 개발자로서 본 개인정보 처리방침을 언제든지 업데이트할 권리를 보유합니다. 모든 변경 사항은 이 페이지에 업데이트된 정책을 게시한 즉시 효력이 발생합니다. 사용자 여러분은 이 페이지를 주기적으로 확인하여 개인정보가 어떻게 보호되는지 파악하시기 바랍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagai pembangun LM Playground, saya berhak untuk mengemas kini Dasar Privasi ini pada bila-bila masa. Sebarang perubahan akan berkuat kuasa serta-merta setelah dasar yang dikemas kini disiarkan. Pengguna digalakkan untuk menyemak halaman ini secara berkala dan sentiasa dimaklumkan tentang bagaimana privasi mereka dilindungi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Som utvikler av LM Playground forbeholder jeg meg retten til å oppdatere denne personvernerklæringen når som helst. Eventuelle endringer vil tre i kraft umiddelbart etter at den oppdaterte erklæringen er publisert. Brukere oppfordres til å gjennomgå denne siden jevnlig og holde seg informert om hvordan personvernet deres beskyttes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als ontwikkelaar van LM Playground behoud ik me het recht voor om dit privacybeleid op elk moment bij te werken. Wijzigingen worden onmiddellijk van kracht zodra het bijgewerkte beleid wordt geplaatst. Gebruikers worden aangemoedigd om deze pagina regelmatig te bekijken en op de hoogte te blijven van hoe hun privacy wordt beschermd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako twórca LM Playground zastrzegam sobie prawo do aktualizacji niniejszej Polityki prywatności w dowolnym momencie. Wszelkie zmiany wchodzą w życie natychmiast po opublikowaniu zaktualizowanej polityki. Zachęcamy użytkowników do okresowego przeglądania tej strony i pozostawania na bieżąco z tym, jak chroniona jest ich prywatność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como desenvolvedor do LM Playground, reservo-me o direito de atualizar esta Política de Privacidade a qualquer momento. Quaisquer alterações serão efetivas imediatamente após a publicação da política atualizada. Os usuários são encorajados a revisar esta página periodicamente e a se manter informados sobre como sua privacidade é protegida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca dezvoltator al LM Playground, îmi rezerv dreptul de a actualiza această Politică de Confidențialitate în orice moment. Orice modificare va fi efectivă imediat după publicarea politicii actualizate. Utilizatorii sunt încurajați să verifice periodic această pagină şi să rămână informați despre modul în care le este protejată confidențialitatea."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Som utvecklare av LM Playground förbehåller jag mig rätten att uppdatera denna integritetspolicy när som helst. Eventuella ändringar träder i kraft omedelbart när den uppdaterade policyn publiceras. Användare uppmanas att regelbundet granska denna sida och hålla sig informerade om hur deras integritet skyddas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในฐานะผู้พัฒนา LM Playground ผมขอสงวนสิทธิ์ในการอัปเดตนโยบายความเป็นส่วนตัวนี้ได้ตลอดเวลา การเปลี่ยนแปลงใดๆ จะมีผลทันทีเมื่อโพสต์นโยบายที่อัปเดตแล้ว ขอแนะนำให้ผู้ใช้ตรวจสอบหน้านี้เป็นระยะและรับทราบว่าความเป็นส่วนตัวของพวกเขาได้รับการคุ้มครองอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Playground'un geliştiricisi olarak, bu Gizlilik Politikasını istediğim zaman güncelleme hakkını saklı tutuyorum. Herhangi bir değişiklik, güncellenen politikanın yayınlanmasıyla derhal yürürlüğe girecektir. Kullanıcıların bu sayfayı düzenli olarak gözden geçirmeleri ve gizliliklerinin nasıl korunduğu hakkında bilgi sahibi olmaları teşvik edilmektedir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як розробник LM Playground, я залишаю за собою право оновлювати цю Політику конфіденційності в будь-який час. Будь-які зміни набувають чинності одразу після публікації оновленої політики. Користувачам рекомендується періодично переглядати цю сторінку та залишатися в курсі того, як захищається їхня конфіденційність."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với tư cách là nhà phát triển của LM Playground, tôi có quyền cập nhật Chính sách Bảo mật này bất cứ lúc nào. Bất kỳ thay đổi nào sẽ có hiệu lực ngay lập tức sau khi chính sách cập nhật được đăng. Người dùng được khuyến khích thường xuyên xem lại trang này và cập nhật về cách quyền riêng tư của mình được bảo vệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作为 LM Playground 的开发者，我保留随时更新本隐私政策的权利。任何更改将在本页面发布更新政策后立即生效。建议用户经常查看此页面，及时了解其隐私是如何受到保护的。"
          }
        }
      }
    },
