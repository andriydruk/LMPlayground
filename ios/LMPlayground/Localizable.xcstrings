    "How much storage space do I need?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم مساحة التخزين التي أحتاجها؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমার কত স্টোরেজ স্পেস দরকার?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik úložného prostoru potřebuji?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor meget lagerplads har jeg brug for?"
