    "This document couldn't be read. It may be corrupt.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة هذا المستند. قد يكون تالفًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নথিটি পড়া যায়নি। এটি ক্ষতিগ্রস্ত হতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento dokument se nepodařilo přečíst. Může být poškozený."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentet kunne ikke læses. Det er muligvis beskadiget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument konnte nicht gelesen werden. Es ist möglicherweise beschädigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer este documento. Puede estar dañado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asiakirjaa ei voitu lukea. Se saattaa olla vioittunut."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabasa ang dokumentong ito. Maaaring sira ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire ce document. Il est peut-être endommagé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקרוא את המסמך. ייתכן שהוא פגום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह दस्तावेज़ पढ़ा नहीं जा सका. यह ख़राब हो सकता है."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen ini tidak dapat dibaca. Mungkin rusak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere questo documento. Potrebbe essere danneggiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このドキュメントを読み取れませんでした。破損している可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서를 읽을 수 없습니다. 손상되었을 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen ini tidak dapat dibaca. Ia mungkin rosak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentet kunne ikke leses. Det kan være skadet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit document kon niet worden gelezen. Het is mogelijk beschadigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać tego dokumentu. Może być uszkodzony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler este documento. Ele pode estar corrompido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest document nu a putut fi citit. Ar putea fi corupt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att läsa dokumentet. Det kan vara skadat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านเอกสารนี้ไม่ได้ อาจเสียหาย"
