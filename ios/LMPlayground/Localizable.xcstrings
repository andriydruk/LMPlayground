          "stringUnit": {
            "state": "translated",
            "value": "ছবি মডিউল মডেলকে ছবি দেখতে দেয়। এটি পরে যোগ করতে পারেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul obrázků umožní modelu prohlížet fotky. Můžete ho přidat později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedmodulet lader modellen se på fotos. Du kan tilføje det senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Bildmodul kann das Modell Fotos ansehen. Du kannst es auch später hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El módulo de imágenes permite que el modelo vea fotos. Puedes añadirlo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvamoduulin avulla malli voi katsoa kuvia. Voit lisätä sen myöhemmin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinapayagan ng image module na makita ng modelo ang mga larawan. Puwede mo itong idagdag mamaya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le module d’images permet au modèle de regarder des photos. Vous pourrez l’ajouter plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מודול התמונות מאפשר למודל להסתכל על תמונות. אפשר להוסיף אותו מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इमेज मॉड्यूल से मॉडल फ़ोटो देख सकता है। आप इसे बाद में भी जोड़ सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul gambar memungkinkan model melihat foto. Anda dapat menambahkannya nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modulo immagini permette al modello di guardare le foto. Puoi aggiungerlo in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像モジュールを追加すると、モデルが写真を見られるようになります。あとから追加することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 모듈을 추가하면 모델이 사진을 볼 수 있습니다. 나중에 추가할 수도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul imej membolehkan model melihat foto. Anda boleh menambahnya kemudian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildemodulen lar modellen se på bilder. Du kan legge den til senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met de beeldmodule kan het model foto’s bekijken. Je kunt hem later toevoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moduł obrazów pozwala modelowi oglądać zdjęcia. Możesz dodać go później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O módulo de imagens permite que o modelo veja fotos. Você pode adicioná-lo depois."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modulul de imagini permite modelului să vadă fotografii. Îl poți adăuga mai târziu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med bildmodulen kan modellen titta på foton. Du kan lägga till den senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมดูลรูปภาพช่วยให้โมเดลดูรูปถ่ายได้ คุณเพิ่มภายหลังได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü modülü, modelin fotoğraflara bakmasını sağlar. Daha sonra da ekleyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модуль зображень дає моделі змогу переглядати фото. Його можна додати пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô-đun hình ảnh cho phép mô hình xem ảnh. Bạn có thể thêm sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像模块让模型能够查看照片。你也可以稍后添加。"
          }
        }
      }
    },
    "The model couldn't read the tool results.": {
      "localizations": {
