    "This document is password-protected and can't be read.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المستند محمي بكلمة مرور ولا يمكن قراءته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নথিটি পাসওয়ার্ড দিয়ে সুরক্ষিত, তাই এটি পড়া যাচ্ছে না।"
          }
        },
        "cs": {
