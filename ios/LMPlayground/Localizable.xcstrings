    "Speaking instead of typing needs a speech-recognition model, %@ (%@), downloaded once and kept on your device. It works offline, in 35 languages.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب التحدث بدلًا من الكتابة نموذجًا للتعرّف على الكلام، %1$@ (%2$@)، يُنزَّل مرة واحدة ويُحفظ على جهازك. يعمل دون اتصال وبـ 35 لغة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাইপের বদলে কথা বলতে একটি স্পিচ-রিকগনিশন মডেল লাগবে, %1$@ (%2$@), যা একবার ডাউনলোড হয়ে আপনার ডিভাইসেই থাকবে। এটি অফলাইনে, ৩৫টি ভাষায় কাজ করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mluvení místo psaní vyžaduje model pro rozpoznávání řeči, %1$@ (%2$@), který se stáhne jednou a zůstane ve vašem zařízení. Funguje offline ve 35 jazycích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at tale i stedet for at skrive skal du bruge en talegenkendelsesmodel, %1$@ (%2$@), som hentes én gang og gemmes på din enhed. Den virker offline på 35 sprog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um zu sprechen statt zu tippen, brauchst du ein Spracherkennungsmodell, %1$@ (%2$@), das einmal heruntergeladen und auf deinem Gerät gespeichert wird. Es funktioniert offline in 35 Sprachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para hablar en lugar de escribir se necesita un modelo de reconocimiento de voz, %1$@ (%2$@), que se descarga una vez y se guarda en tu dispositivo. Funciona sin conexión, en 35 idiomas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhuminen kirjoittamisen sijaan vaatii puheentunnistusmallin, %1$@ (%2$@), joka ladataan kerran ja säilytetään laitteellasi. Se toimii offline-tilassa 35 kielellä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para magsalita sa halip na mag-type, kailangan ng speech-recognition model, %1$@ (%2$@), na ida-download nang isang beses at itatabi sa device mo. Gumagana ito offline, sa 35 wika."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour parler au lieu de taper, il faut un modèle de reconnaissance vocale, %1$@ (%2$@), téléchargé une seule fois et conservé sur votre appareil. Il fonctionne hors ligne, dans 35 langues."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לדבר במקום להקליד צריך מודל לזיהוי דיבור, %1$@ (%2$@), שמורד פעם אחת ונשמר במכשיר. הוא עובד אופליין, ב-35 שפות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइप करने के बजाय बोलने के लिए एक स्पीच-रिकग्निशन मॉडल, %1$@ (%2$@), चाहिए, जो एक बार डाउनलोड होकर आपके डिवाइस पर रहता है। यह ऑफ़लाइन, 35 भाषाओं में काम करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk berbicara alih-alih mengetik, diperlukan model pengenalan ucapan, %1$@ (%2$@), yang diunduh sekali dan disimpan di perangkat Anda. Model ini berfungsi offline, dalam 35 bahasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per parlare invece di scrivere serve un modello di riconoscimento vocale, %1$@ (%2$@), scaricato una sola volta e conservato sul tuo dispositivo. Funziona offline, in 35 lingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力の代わりに話すには、音声認識モデル %1$@（%2$@）が必要です。一度ダウンロードすれば端末に保存され、オフラインで 35 言語に対応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이핑 대신 말하려면 음성 인식 모델 %1$@(%2$@)이(가) 필요합니다. 한 번 다운로드하면 기기에 보관되며, 오프라인으로 35개 언어를 지원합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk bercakap dan bukannya menaip, anda memerlukan model pengecaman pertuturan, %1$@ (%2$@), yang dimuat turun sekali dan disimpan pada peranti anda. Ia berfungsi di luar talian, dalam 35 bahasa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å snakke i stedet for å skrive trenger du en talegjenkjenningsmodell, %1$@ (%2$@), som lastes ned én gang og lagres på enheten din. Den fungerer uten nett, på 35 språk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om te spreken in plaats van te typen is een spraakherkenningsmodel nodig, %1$@ (%2$@), dat één keer wordt gedownload en op je apparaat blijft. Het werkt offline, in 35 talen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby mówić zamiast pisać, potrzebny jest model rozpoznawania mowy, %1$@ (%2$@), pobierany raz i przechowywany na Twoim urządzeniu. Działa offline, w 35 językach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para falar em vez de digitar, é preciso um modelo de reconhecimento de fala, %1$@ (%2$@), baixado uma única vez e guardado no seu dispositivo. Ele funciona offline, em 35 idiomas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca să vorbești în loc să tastezi, ai nevoie de un model de recunoaștere a vorbirii, %1$@ (%2$@), descărcat o singură dată și păstrat pe dispozitivul tău. Funcționează offline, în 35 de limbi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att prata i stället för att skriva behövs en taligenkänningsmodell, %1$@ (%2$@), som laddas ned en gång och sparas på din enhet. Den fungerar offline, på 35 språk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การพูดแทนการพิมพ์ต้องใช้โมเดลรู้จำเสียงพูด %1$@ (%2$@) ซึ่งดาวน์โหลดเพียงครั้งเดียวและเก็บไว้ในอุปกรณ์ของคุณ ใช้งานแบบออฟไลน์ได้ 35 ภาษา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazmak yerine konuşmak için bir kez indirilip cihazınızda saklanan bir konuşma tanıma modeli gerekir: %1$@ (%2$@). Çevrimdışı ve 35 dilde çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб говорити замість друкувати, потрібна модель розпізнавання мовлення, %1$@ (%2$@), яка завантажується один раз і зберігається на вашому пристрої. Вона працює офлайн, 35 мовами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để nói thay vì gõ, bạn cần một mô hình nhận dạng giọng nói, %1$@ (%2$@), chỉ tải về một lần và lưu trên thiết bị của bạn. Mô hình hoạt động ngoại tuyến, với 35 ngôn ngữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用说话代替打字需要一个语音识别模型 %1$@（%2$@），只需下载一次并保存在你的设备上。它可离线使用，支持 35 种语言。"
          }
        }
      }
    },
