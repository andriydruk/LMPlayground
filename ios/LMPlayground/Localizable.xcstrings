    "Allow microphone access to dictate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الميكروفون للإملاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিক্টেট করতে মাইক্রোফোনের অনুমতি দিন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro diktování povolte přístup k mikrofonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv adgang til mikrofonen for at diktere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Mikrofonzugriff, um zu diktieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso al micrófono para dictar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli mikrofonin käyttö sanelua varten."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan ang access sa mikropono para mag-dictate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès au micro pour dicter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרו גישה למיקרופון כדי להכתיב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिक्टेट करने के लिए माइक्रोफ़ोन की अनुमति दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses mikrofon untuk mendikte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso al microfono per dettare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力にはマイクへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰려면 마이크 접근을 허용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan akses mikrofon untuk mengimlak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi tilgang til mikrofonen for å diktere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef toegang tot de microfoon om te dicteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
