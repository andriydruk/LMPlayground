    "Indexing failed. Try attaching the document again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت الفهرسة. حاول إرفاق المستند مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইনডেক্সিং ব্যর্থ হয়েছে। নথিটি আবার সংযুক্ত করার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Indexování selhalo. Zkuste dokument připojit znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeksering mislykkedes. Prøv at vedhæfte dokumentet igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Indexierung fehlgeschlagen. Versuche, das Dokument erneut anzuhängen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la indexación. Intenta adjuntar el documento de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeksointi epäonnistui. Yritä liittää asiakirja uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabigo ang pag-index. Subukang ilakip muli ang dokumento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'indexation. Réessayez de joindre le document."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האינדוקס נכשל. נסה לצרף שוב את המסמך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंडेक्सिंग विफल रही. दस्तावेज़ को फिर से अटैच करके देखें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengindeksan gagal. Coba lampirkan dokumen lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indicizzazione non riuscita. Prova ad allegare di nuovo il documento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インデックス作成に失敗しました。もう一度ドキュメントを添付してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색인 생성에 실패했습니다. 문서를 다시 첨부해 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengindeksan gagal. Cuba lampirkan dokumen sekali lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeksering mislyktes. Prøv å legge ved dokumentet på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indexeren mislukt. Probeer het document opnieuw toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeksowanie nie powiodło się. Spróbuj załączyć dokument ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na indexação. Tente anexar o documento novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Indexarea a eșuat. Încearcă să atașezi documentul din nou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Indexeringen misslyckades. Försök bifoga dokumentet igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจัดทำดัชนีไม่สำเร็จ ลองแนบเอกสารอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizine ekleme başarısız oldu. Belgeyi yeniden eklemeyi deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Індексування не вдалося. Спробуйте прикріпити документ ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lập chỉ mục không thành công. Hãy thử đính kèm lại tài liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "索引失败。请重新附加文档。"
          }
        }
      }
    },
    "Internet is needed to download models, and — if you turn them on — for the optional web tools (web search and fetch page). Apart from that, once a model is downloaded it runs completely offline on your device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإنترنت مطلوب لتنزيل النماذج، و — إذا قمت بتفعيلها — لأدوات الويب الاختيارية (البحث في الويب وجلب الصفحات). وفيما عدا ذلك، بمجرد تنزيل النموذج فإنه يعمل بالكامل دون اتصال على جهازك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মডেল ডাউনলোড করতে, এবং — আপনি যদি সেগুলি চালু করেন — ঐচ্ছিক ওয়েব টুলের (ওয়েব অনুসন্ধান ও পেজ ফেচ) জন্য ইন্টারনেট প্রয়োজন। এ ছাড়া, একবার মডেল ডাউনলোড হয়ে গেলে এটি আপনার ডিভাইসে সম্পূর্ণ অফলাইনে চলে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet je potřeba ke stažení modelů a — pokud je zapnete — pro volitelné webové nástroje (vyhledávání na webu a načtení stránky). Kromě toho po stažení běží model kompletně offline na vašem zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet er nødvendigt for at downloade modeller og — hvis du slår dem til — for de valgfrie webværktøjer (websøgning og hent side). Bortset fra det kører en model helt offline på din enhed, når den først er downloadet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet wird zum Herunterladen von Modellen benötigt und — falls Sie sie aktivieren — für die optionalen Web-Tools (Websuche und Seite abrufen). Davon abgesehen läuft ein Modell nach dem Herunterladen vollständig offline auf Ihrem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita Internet para descargar modelos y — si las activas — para las herramientas web opcionales (búsqueda web y obtener página). Aparte de eso, una vez descargado, el modelo funciona completamente sin conexión en tu dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Internetiä tarvitaan mallien lataamiseen sekä — jos otat ne käyttöön — valinnaisiin verkkotyökaluihin (verkkohaku ja sivun nouto). Sen lisäksi malli toimii latauksen jälkeen täysin offline-tilassa laitteellasi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ang internet upang mag-download ng mga modelo, at — kung io-on mo ang mga ito — para sa mga opsyonal na web tool (web search at kunin ang page). Bukod doon, kapag na-download na ang isang modelo, ganap itong tumatakbo offline sa iyong device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet est nécessaire pour télécharger les modèles et — si vous les activez — pour les outils web optionnels (recherche web et chargement de page). À part cela, une fois un modèle téléchargé, il fonctionne entièrement hors ligne sur votre appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אינטרנט נדרש להורדת מודלים, ו — אם תפעיל אותם — לכלי הווב האופציונליים (חיפוש באינטרנט ושליפת דף). מלבד זאת, לאחר שמודל הורד הוא פועל לחלוטין במצב לא מקוון במכשיר שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरनेट मॉडल डाउनलोड करने के लिए, और — यदि आप उन्हें चालू करते हैं — वैकल्पिक वेब टूल (वेब खोज और पेज फ़ेच) के लिए ज़रूरी है। इसके अलावा, मॉडल डाउनलोड होने के बाद आपके डिवाइस पर पूरी तरह ऑफ़लाइन चलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet diperlukan untuk mengunduh model, dan — jika Anda mengaktifkannya — untuk alat web opsional (pencarian web dan ambil halaman). Selain itu, setelah model diunduh, model berjalan sepenuhnya secara offline di perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet è necessario per scaricare i modelli e — se li attivi — per gli strumenti web opzionali (ricerca web e caricamento pagina). A parte questo, una volta scaricato, il modello funziona completamente offline sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネットはモデルのダウンロードに必要で、また——オンにした場合は——任意のウェブツール（ウェブ検索とページ取得）にも必要です。それ以外は、モデルをダウンロードしてしまえば、お使いのデバイス上で完全にオフラインで動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷은 모델을 다운로드할 때 필요하며——사용자가 켠 경우——선택적 웹 도구(웹 검색 및 페이지 가져오기)에도 필요합니다. 그 외에는 모델을 한 번 다운로드하면 기기에서 완전히 오프라인으로 작동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet diperlukan untuk memuat turun model, dan — jika anda menghidupkannya — untuk alat web pilihan (carian web dan ambil halaman). Selain itu, setelah model dimuat turun, ia berjalan sepenuhnya luar talian pada peranti anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Internett er nødvendig for å laste ned modeller, og — hvis du slår dem på — for de valgfrie nettverktøyene (nettsøk og hent side). Bortsett fra det kjører en modell helt offline på enheten din når den først er lastet ned."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet is nodig om modellen te downloaden en — als je ze inschakelt — voor de optionele webtools (zoeken op het web en pagina ophalen). Afgezien daarvan werkt een model, eenmaal gedownload, volledig offline op je apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet jest potrzebny do pobierania modeli oraz — jeśli je włączysz — do opcjonalnych narzędzi internetowych (wyszukiwanie w sieci i pobieranie stron). Poza tym, po pobraniu, model działa całkowicie offline na Twoim urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Internet é necessária para baixar modelos e — se você as ativar — para as ferramentas web opcionais (busca na web e carregar página). Fora isso, depois de baixado, o modelo funciona completamente offline no seu dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Internetul este necesar pentru descărcarea modelelor şi — dacă le activezi — pentru instrumentele web opționale (căutare web şi încărcare pagină). În rest, odată descărcat, modelul funcționează complet offline pe dispozitivul tău."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet behövs för att ladda ned modeller och — om du slår på dem — för de valfria webbverktygen (webbsökning och hämta sida). Bortsett från det körs en modell helt offline på din enhet när den väl har laddats ned."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อินเทอร์เน็ตจำเป็นสำหรับการดาวน์โหลดโมเดล และ — หากคุณเปิดใช้งาน — สำหรับเครื่องมือเว็บเสริม (ค้นหาเว็บและดึงหน้าเว็บ) นอกเหนือจากนั้น เมื่อดาวน์โหลดโมเดลแล้ว มันจะทำงานแบบออฟไลน์อย่างสมบูรณ์บนอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet, modelleri indirmek ve — açarsanız — isteğe bağlı web araçları (web araması ve sayfa getirme) için gereklidir. Bunun dışında, bir model indirildikten sonra cihazınızda tamamen çevrimdışı çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інтернет потрібен для завантаження моделей і — якщо ви їх увімкнете — для опціональних вебінструментів (пошук у мережі та завантаження сторінок). Окрім цього, після завантаження модель працює повністю офлайн на вашому пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet cần thiết để tải xuống các mô hình, và — nếu bạn bật chúng — cho các công cụ web tùy chọn (tìm kiếm web và tải trang). Ngoài ra, một khi mô hình đã được tải xuống, nó chạy hoàn toàn ngoại tuyến trên thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载模型时需要联网，并且——如果您开启了可选的网络工具（网络搜索和抓取网页）——使用这些工具时也需要联网。除此之外，模型下载完成后，便会在您的设备上完全离线运行。"
          }
        }
      }
    },
    "Is my data private?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل بياناتي خاصة؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমার ডেটা কি গোপন?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jsou moje data soukromá?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er mine data private?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind meine Daten privat?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Mis datos son privados?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovatko tietoni yksityisiä?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pribado ba ang aking data?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mes données sont-elles privées ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם הנתונים שלי פרטיים?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या मेरा डेटा निजी है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah data saya pribadi?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I miei dati sono privati?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データのプライバシーは守られますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 데이터는 안전한가요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah data saya peribadi?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er dataene mine private?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zijn mijn gegevens privé?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy moje dane są prywatne?"
          }
        },
        "pt-BR": {
          "stringUnit": {
