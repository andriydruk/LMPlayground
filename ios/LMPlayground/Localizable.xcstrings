    "Can I ask questions about a document?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يمكنني طرح أسئلة عن مستند؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো নথি নিয়ে কি প্রশ্ন করতে পারি?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžu se ptát na obsah dokumentu?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan jeg stille spørgsmål om et dokument?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann ich Fragen zu einem Dokument stellen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Puedo hacer preguntas sobre un documento?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voinko kysyä kysymyksiä asiakirjasta?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede ba akong magtanong tungkol sa isang dokumento?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis-je poser des questions sur un document ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לשאול שאלות על מסמך?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या मैं किसी दस्तावेज़ के बारे में सवाल पूछ सकता हूँ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisakah saya bertanya tentang dokumen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso fare domande su un documento?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドキュメントについて質問できますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서에 대해 질문할 수 있나요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bolehkah saya bertanya tentang dokumen?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan jeg stille spørsmål om et dokument?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ik vragen stellen over een document?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy mogę zadawać pytania o dokument?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso fazer perguntas sobre um documento?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pot pune întrebări despre un document?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan jag ställa frågor om ett dokument?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามคำถามเกี่ยวกับเอกสารได้ไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir belge hakkında soru sorabilir miyim?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи можна ставити запитання про документ?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi có thể hỏi về một tài liệu không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以针对文档提问吗？"
          }
        }
      }
    },
