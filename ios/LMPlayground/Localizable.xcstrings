    "No models yet. Download one below, or import a GGUF file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد نماذج بعد. نزّل نموذجًا أدناه أو استورد ملف GGUF."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো মডেল নেই। নিচে থেকে একটি ডাউনলোড করুন বা একটি GGUF ফাইল ইমপোর্ট করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné modely. Stáhněte si jeden níže nebo importujte soubor GGUF."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen modeller endnu. Download en nedenfor, eller importér en GGUF-fil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Modelle. Lade unten eines herunter oder importiere eine GGUF-Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay modelos. Descarga uno abajo o importa un archivo GGUF."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä malleja. Lataa malli alta tai tuo GGUF-tiedosto."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang modelo. Mag-download ng isa sa ibaba, o mag-import ng GGUF file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun modèle pour l’instant. Téléchargez-en un ci-dessous ou importez un fichier GGUF."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין מודלים. הורידו מודל למטה או ייבאו קובץ GGUF."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई मॉडल नहीं। नीचे से एक डाउनलोड करें या GGUF फ़ाइल इंपोर्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada model. Unduh satu di bawah, atau impor file GGUF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun modello. Scaricane uno qui sotto o importa un file GGUF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだモデルがありません。下からダウンロードするか、GGUF ファイルを読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 모델이 없습니다. 아래에서 다운로드하거나 GGUF 파일을 가져오세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada model. Muat turun satu di bawah, atau import fail GGUF."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen modeller ennå. Last ned en nedenfor, eller importer en GGUF-fil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen modellen. Download er hieronder een of importeer een GGUF-bestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak modeli. Pobierz model poniżej lub zaimportuj plik GGUF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum modelo ainda. Baixe um abaixo ou importe um arquivo GGUF."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă niciun model. Descarcă unul mai jos sau importă un fișier GGUF."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga modeller än. Ladda ned en nedan eller importera en GGUF-fil."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีโมเดล ดาวน์โหลดจากด้านล่าง หรือนำเข้าไฟล์ GGUF"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz model yok. Aşağıdan bir model indir veya bir GGUF dosyası içe aktar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Моделей ще немає. Завантажте одну нижче або імпортуйте файл GGUF."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có mô hình. Tải một mô hình bên dưới hoặc nhập tệp GGUF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有模型。请在下方下载一个，或导入 GGUF 文件。"
          }
        }
      }
    },
    "No readable text found — scanned documents aren't supported yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على نص قابل للقراءة — المستندات الممسوحة ضوئيًا غير مدعومة بعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাঠযোগ্য কোনো লেখা পাওয়া যায়নি — স্ক্যান করা নথি এখনও সমর্থিত নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyl nalezen žádný čitelný text – naskenované dokumenty zatím nejsou podporovány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen læsbar tekst fundet – scannede dokumenter understøttes ikke endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein lesbarer Text gefunden – gescannte Dokumente werden noch nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró texto legible: los documentos escaneados aún no son compatibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luettavaa tekstiä ei löytynyt – skannattuja asiakirjoja ei vielä tueta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nabasa na teksto — hindi pa sinusuportahan ang mga na-scan na dokumento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun texte lisible trouvé — les documents numérisés ne sont pas encore pris en charge."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצא טקסט קריא — מסמכים סרוקים עדיין אינם נתמכים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई पढ़ने योग्य टेक्स्ट नहीं मिला — स्कैन किए गए दस्तावेज़ अभी समर्थित नहीं हैं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada teks yang bisa dibaca — dokumen hasil pindai belum didukung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun testo leggibile trovato — i documenti scansionati non sono ancora supportati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れるテキストが見つかりませんでした。スキャンされたドキュメントにはまだ対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽을 수 있는 텍스트를 찾을 수 없습니다. 스캔한 문서는 아직 지원되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada teks boleh baca ditemui — dokumen diimbas belum disokong."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen lesbar tekst – skannede dokumenter støttes ikke ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen leesbare tekst gevonden — gescande documenten worden nog niet ondersteund."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono czytelnego tekstu — zeskanowane dokumenty nie są jeszcze obsługiwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum texto legível encontrado — documentos digitalizados ainda não são aceitos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a găsit text lizibil — documentele scanate nu sunt încă acceptate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen läsbar text hittades – skannade dokument stöds inte än."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบข้อความที่อ่านได้ — ยังไม่รองรับเอกสารที่สแกนมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunabilir metin bulunamadı — taranan belgeler henüz desteklenmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
