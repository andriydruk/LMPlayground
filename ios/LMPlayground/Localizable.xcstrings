    "Do the web tools send my data online?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل ترسل أدوات الويب بياناتي عبر الإنترنت؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়েব টুলগুলি কি আমার ডেটা অনলাইনে পাঠায়?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesílají webové nástroje moje data online?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender webværktøjerne mine data online?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden die Web-Tools meine Daten ins Internet?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Las herramientas web envían mis datos a internet?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettävätkö verkkotyökalut tietojani verkkoon?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagpapadala ba ng aking data online ang mga web tool?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils web envoient-ils mes données en ligne ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם כלי הווב שולחים את הנתונים שלי לאינטרנט?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या वेब टूल मेरा डेटा ऑनलाइन भेजते हैं?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah alat web mengirim data saya ke internet?"
          }
        },
        "it": {
