    "%@ is ready to use.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ جاهز للاستخدام."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ব্যবহারের জন্য প্রস্তুত।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je připraven k použití."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er klar til brug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist einsatzbereit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está listo para usar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on valmis käyttöön."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Handa nang gamitin ang %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est prêt à l’emploi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ מוכן לשימוש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ इस्तेमाल के लिए तैयार है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ siap digunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è pronto all’uso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を使用する準備ができました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 사용할 준비가 되었습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sedia untuk digunakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er klar til bruk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is klaar voor gebruik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest gotowy do użycia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está pronto para usar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ este gata de utilizare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är redo att användas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ พร้อมใช้งานแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kullanıma hazır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ готова до використання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã sẵn sàng để sử dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已可以使用。"
          }
        }
      }
    },
    "%@ stopped the app while loading (%@). It won't be loaded automatically.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ أوقف التطبيق أثناء التحميل (%2$@). لن يتم تحميله تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লোড হওয়ার সময় %1$@ অ্যাপটি বন্ধ করে দিয়েছে (%2$@)। এটি আর স্বয়ংক্রিয়ভাবে লোড হবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ při načítání ukončil aplikaci (%2$@). Nebude se načítat automaticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stoppede appen under indlæsning (%2$@). Den indlæses ikke automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat die App beim Laden beendet (%2$@). Das Modell wird nicht automatisch geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cerró la app mientras se cargaba (%2$@). No se cargará automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pysäytti sovelluksen latauksen aikana (%2$@). Sitä ei ladata automaattisesti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Napahinto ng %1$@ ang app habang naglo-load (%2$@). Hindi na ito awtomatikong ilo-load."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a arrêté l’app pendant le chargement (%2$@). Il ne sera pas chargé automatiquement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ עצר את האפליקציה בזמן הטעינה (%2$@). הוא לא ייטען אוטומטית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोड होते समय %1$@ की वजह से ऐप बंद हो गया (%2$@)। इसे अपने-आप लोड नहीं किया जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ menghentikan aplikasi saat dimuat (%2$@). Model ini tidak akan dimuat otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha chiuso l’app durante il caricamento (%2$@). Non verrà caricato automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の読み込み中にアプリが停止しました（%2$@）。このモデルは自動では読み込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 불러오는 중 앱이 중단되었습니다(%2$@). 자동으로 불러오지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ menghentikan apl semasa dimuatkan (%2$@). Model ini tidak akan dimuatkan secara automatik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stoppet appen under innlasting (%2$@). Den lastes ikke inn automatisk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ liet de app stoppen tijdens het laden (%2$@). Het wordt niet automatisch geladen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zatrzymał aplikację podczas wczytywania (%2$@). Nie zostanie wczytany automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fechou o app durante o carregamento (%2$@). Ele não será carregado automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a oprit aplicația în timpul încărcării (%2$@). Nu va fi încărcat automat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stoppade appen under inläsningen (%2$@). Den läses inte in automatiskt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ทำให้แอปหยุดทำงานระหว่างโหลด (%2$@) จะไม่โหลดโมเดลนี้โดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ yüklenirken uygulamayı durdurdu (%2$@). Otomatik olarak yüklenmeyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ зупинила застосунок під час завантаження (%2$@). Її не буде завантажено автоматично."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã làm ứng dụng dừng khi đang tải (%2$@). Mô hình này sẽ không được tải tự động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载 %1$@ 时应用停止运行（%2$@）。它不会再被自动加载。"
          }
        }
      }
    },
