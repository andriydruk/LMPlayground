        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息"
          }
        }
      }
    },
    "Metal makes replies much faster. Turn it off only if a model produces garbled output or crashes; it applies the next time a model loads.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجعل Metal الردود أسرع بكثير. لا توقفه إلا إذا أنتج النموذج مخرجات مشوشة أو تعطل؛ ويسري التغيير عند تحميل النموذج التالي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal উত্তর অনেক দ্রুত করে। কোনো মডেল এলোমেলো আউটপুট দিলে বা ক্র্যাশ করলে তবেই এটি বন্ধ করুন; পরিবর্তনটি পরের বার মডেল লোড হলে কার্যকর হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal výrazně zrychluje odpovědi. Vypněte ho jen v případě, že model generuje nesmysly nebo padá; změna se projeví při dalším načtení modelu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal gør svarene meget hurtigere. Slå det kun fra, hvis en model laver uforståelig tekst eller går ned; ændringen gælder næste gang en model indlæses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal macht Antworten deutlich schneller. Schalte es nur aus, wenn ein Modell unsinnige Ausgaben erzeugt oder abstürzt. Die Änderung gilt beim nächsten Laden eines Modells."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal hace que las respuestas sean mucho más rápidas. Desactívalo solo si un modelo genera texto sin sentido o se bloquea; el cambio se aplica la próxima vez que se cargue un modelo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal nopeuttaa vastauksia huomattavasti. Poista se käytöstä vain, jos malli tuottaa sekavaa tekstiä tai kaatuu; muutos tulee voimaan, kun malli ladataan seuraavan kerran."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinapabilis nang husto ng Metal ang mga sagot. I-off lang ito kung magulo ang output ng isang modelo o nagka-crash ito; magkakabisa ang pagbabago sa susunod na pag-load ng modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal rend les réponses bien plus rapides. Désactivez-le uniquement si un modèle produit du texte incohérent ou plante ; le changement s’applique au prochain chargement d’un modèle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal מאיץ מאוד את התשובות. כבו אותו רק אם מודל מפיק פלט משובש או קורס; השינוי יחול בטעינת המודל הבאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal से जवाब काफ़ी तेज़ मिलते हैं। इसे सिर्फ़ तब बंद करें जब कोई मॉडल बेतुका आउटपुट दे या क्रैश हो; बदलाव अगली बार मॉडल लोड होने पर लागू होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal membuat balasan jauh lebih cepat. Matikan hanya jika model menghasilkan teks kacau atau mogok; perubahan berlaku saat model dimuat berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal rende le risposte molto più veloci. Disattivalo solo se un modello produce testo incomprensibile o si blocca; la modifica si applica al prossimo caricamento di un modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal を使うと返信が大幅に速くなります。モデルが意味不明な出力をしたりクラッシュしたりする場合のみオフにしてください。変更は次にモデルを読み込んだときに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal을 사용하면 답변이 훨씬 빨라집니다. 모델이 깨진 출력을 내거나 중단될 때만 끄세요. 변경 사항은 다음에 모델을 불러올 때 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal menjadikan balasan jauh lebih pantas. Matikan hanya jika model menghasilkan teks bercelaru atau ranap; perubahan berkuat kuasa apabila model dimuatkan seterusnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal gjør svarene mye raskere. Slå det bare av hvis en modell lager uforståelig tekst eller krasjer; endringen gjelder neste gang en modell lastes inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal maakt antwoorden veel sneller. Zet het alleen uit als een model onzin produceert of crasht; de wijziging geldt bij het volgende laden van een model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal znacznie przyspiesza odpowiedzi. Wyłącz go tylko, jeśli model generuje bezsensowny tekst lub się zawiesza; zmiana obowiązuje od następnego wczytania modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Metal deixa as respostas muito mais rápidas. Desative-o apenas se um modelo gerar texto sem sentido ou travar; a mudança vale a partir do próximo carregamento de modelo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal face răspunsurile mult mai rapide. Dezactivează-l doar dacă un model produce text fără sens sau se blochează; schimbarea se aplică la următoarea încărcare a unui model."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal gör svaren mycket snabbare. Stäng bara av det om en modell ger obegriplig text eller kraschar; ändringen gäller nästa gång en modell läses in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal ทำให้คำตอบเร็วขึ้นมาก ให้ปิดเฉพาะเมื่อโมเดลแสดงผลผิดเพี้ยนหรือหยุดทำงาน การเปลี่ยนแปลงจะมีผลเมื่อโหลดโมเดลครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal yanıtları çok daha hızlı hâle getirir. Yalnızca bir model anlamsız çıktı üretiyor veya çöküyorsa kapat; değişiklik bir sonraki model yüklemesinde uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal значно пришвидшує відповіді. Вимикайте його, лише якщо модель видає безглуздий текст або аварійно завершується; зміна діятиме з наступного завантаження моделі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal giúp câu trả lời nhanh hơn nhiều. Chỉ tắt nếu mô hình tạo ra nội dung lộn xộn hoặc gặp sự cố; thay đổi có hiệu lực ở lần tải mô hình tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal 能让回复快得多。只有在模型输出乱码或崩溃时才需关闭；更改会在下次加载模型时生效。"
          }
        }
      }
    },
    "Min P": {
      "shouldTranslate": false
    },
    "Model sizes vary from about 500 MB for small models to several GB for larger ones. The app checks free space before downloading.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتراوح أحجام النماذج من نحو 500 ميغابايت للنماذج الصغيرة إلى عدة غيغابايت للأكبر. يتحقق التطبيق من المساحة الفارغة قبل التنزيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মডেলের আকার ছোট মডেলের জন্য প্রায় 500 MB থেকে বড় মডেলের জন্য কয়েক GB পর্যন্ত। ডাউনলোডের আগে অ্যাপ খালি জায়গা যাচাই করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velikost modelů se pohybuje od přibližně 500 MB u malých po několik GB u větších. Aplikace před stažením zkontroluje volné místo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellerne fylder fra ca. 500 MB for små modeller til flere GB for større. Appen tjekker ledig plads før download."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle sind zwischen etwa 500 MB (kleine Modelle) und mehreren GB (größere Modelle) groß. Die App prüft vor dem Download den freien Speicherplatz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño de los modelos va de unos 500 MB en los pequeños a varios GB en los más grandes. La app comprueba el espacio libre antes de descargar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mallien koko vaihtelee pienten mallien noin 500 megatavusta suurempien useisiin gigatavuihin. Sovellus tarkistaa vapaan tilan ennen latausta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang laki ng mga modelo ay mula mga 500 MB para sa maliliit hanggang ilang GB para sa malalaki. Tinitingnan ng app ang bakanteng espasyo bago mag-download."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille des modèles va d’environ 500 Mo pour les petits à plusieurs Go pour les plus grands. L’app vérifie l’espace libre avant de télécharger."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גודל המודלים נע בין כ־500 MB למודלים קטנים לכמה GB לגדולים. האפליקציה בודקת את השטח הפנוי לפני ההורדה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल का आकार छोटे मॉडल के लिए लगभग 500 MB से लेकर बड़े मॉडल के लिए कई GB तक होता है। डाउनलोड से पहले ऐप खाली जगह जाँचता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran model berkisar dari sekitar 500 MB untuk model kecil hingga beberapa GB untuk model besar. Aplikasi memeriksa ruang kosong sebelum mengunduh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dimensioni dei modelli vanno da circa 500 MB per quelli piccoli a diversi GB per quelli più grandi. L’app controlla lo spazio libero prima di scaricare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのサイズは、小さいもので約 500 MB、大きいものでは数 GB です。アプリはダウンロード前に空き容量を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 크기는 작은 모델의 약 500MB부터 큰 모델의 수 GB까지 다양합니다. 앱은 다운로드 전에 여유 공간을 확인합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiz model berbeza dari kira-kira 500 MB untuk model kecil hingga beberapa GB untuk model yang lebih besar. Apl menyemak ruang kosong sebelum memuat turun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellene er fra rundt 500 MB for små modeller til flere GB for større. Appen sjekker ledig plass før nedlasting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen variëren van ongeveer 500 MB voor kleine modellen tot enkele GB voor grotere. De app controleert de vrije ruimte voordat er wordt gedownload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Modele mają od około 500 MB (małe) do kilku GB (większe). Aplikacja sprawdza wolne miejsce przed pobraniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos variam de cerca de 500 MB, os pequenos, a vários GB, os maiores. O app verifica o espaço livre antes de baixar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensiunea modelelor variază de la aproximativ 500 MB pentru cele mici la câțiva GB pentru cele mai mari. Aplicația verifică spațiul liber înainte de descărcare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellerna varierar från cirka 500 MB för små modeller till flera GB för större. Appen kontrollerar ledigt utrymme innan nedladdning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขนาดโมเดลมีตั้งแต่ประมาณ 500 MB สำหรับโมเดลเล็ก จนถึงหลาย GB สำหรับโมเดลใหญ่ แอปจะตรวจสอบพื้นที่ว่างก่อนดาวน์โหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model boyutları küçük modellerde yaklaşık 500 MB'tan büyük modellerde birkaç GB'a kadar değişir. Uygulama indirmeden önce boş alanı kontrol eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір моделей — від близько 500 МБ для малих до кількох ГБ для більших. Застосунок перевіряє вільне місце перед завантаженням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kích thước mô hình dao động từ khoảng 500 MB với mô hình nhỏ đến vài GB với mô hình lớn. Ứng dụng kiểm tra dung lượng trống trước khi tải xuống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型大小从小型模型的约 500 MB 到大型模型的数 GB 不等。应用会在下载前检查可用空间。"
          }
        }
      }
    },
