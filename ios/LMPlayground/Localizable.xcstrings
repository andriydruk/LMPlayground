    "Downloading the embedding model failed. Check your connection and attach the document again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تنزيل نموذج التضمين. تحقق من اتصالك وأرفق المستند مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এমবেডিং মডেল ডাউনলোড করা যায়নি। আপনার সংযোগ পরীক্ষা করে নথিটি আবার সংযুক্ত করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stažení modelu embeddingů selhalo. Zkontrolujte připojení a připojte dokument znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Download af embedding-modellen mislykkedes. Tjek din forbindelse, og vedhæft dokumentet igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Herunterladen des Embedding-Modells fehlgeschlagen. Prüfe deine Verbindung und hänge das Dokument erneut an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar el modelo de embeddings. Comprueba tu conexión y adjunta el documento de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotusmallin lataaminen epäonnistui. Tarkista yhteytesi ja liitä asiakirja uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabigo ang pag-download ng embedding model. Suriin ang iyong koneksyon at ilakip muli ang dokumento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du téléchargement du modèle d'embeddings. Vérifiez votre connexion et joignez le document à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הורדת מודל ה-embedding נכשלה. בדוק את החיבור וצרף שוב את המסמך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एम्बेडिंग मॉडल डाउनलोड नहीं हो सका. अपना कनेक्शन जाँचें और दस्तावेज़ फिर से अटैच करें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal mengunduh model embedding. Periksa koneksi Anda dan lampirkan dokumen lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download del modello di embedding non riuscito. Controlla la connessione e allega di nuovo il documento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "埋め込みモデルのダウンロードに失敗しました。接続を確認して、もう一度ドキュメントを添付してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임베딩 모델 다운로드에 실패했습니다. 연결을 확인하고 문서를 다시 첨부하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal memuat turun model embedding. Semak sambungan anda dan lampirkan dokumen sekali lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedlasting av embedding-modellen mislyktes. Sjekk tilkoblingen og legg ved dokumentet på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaden van het embeddingmodel is mislukt. Controleer je verbinding en voeg het document opnieuw toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się pobrać modelu osadzeń. Sprawdź połączenie i załącz dokument ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao baixar o modelo de embeddings. Verifique sua conexão e anexe o documento novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descărcarea modelului de embedding a eșuat. Verifică conexiunea și atașează documentul din nou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att ladda ner embedding-modellen. Kontrollera din anslutning och bifoga dokumentet igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดโมเดล embedding ไม่สำเร็จ โปรดตรวจสอบการเชื่อมต่อแล้วแนบเอกสารอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleştirme modeli indirilemedi. Bağlantınızı kontrol edip belgeyi yeniden ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити модель ембедингів. Перевірте з’єднання та прикріпіть документ ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được mô hình embedding. Hãy kiểm tra kết nối và đính kèm lại tài liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载嵌入模型失败。请检查网络连接并重新附加文档。"
          }
        }
      }
    },
    "Downloads a page the model asks for. The address leaves the device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينزّل الصفحة التي يطلبها النموذج. يخرج العنوان من الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মডেল যে পৃষ্ঠা চায় তা ডাউনলোড করে। ঠিকানাটি ডিভাইসের বাইরে যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhne stránku, o kterou model požádá. Adresa opustí zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloader en side, som modellen beder om. Adressen forlader enheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt eine Seite, die das Modell anfordert. Die Adresse verlässt das Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga la página que pide el modelo. La dirección sale del dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa sivun, jota malli pyytää. Osoite lähtee laitteelta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina-download ang page na hinihingi ng modelo. Lalabas sa device ang address."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge la page demandée par le modèle. L’adresse quitte l’appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוריד דף שהמודל מבקש. הכתובת יוצאת מהמכשיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल जो पेज माँगे उसे डाउनलोड करता है। पता डिवाइस से बाहर जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunduh halaman yang diminta model. Alamatnya dikirim keluar dari perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica la pagina richiesta dal modello. L’indirizzo lascia il dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが要求したページをダウンロードします。アドレスはデバイスの外に送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 요청한 페이지를 다운로드합니다. 주소가 기기 밖으로 전송됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memuat turun halaman yang diminta model. Alamatnya keluar dari peranti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Laster ned en side modellen ber om. Adressen forlater enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloadt een pagina die het model opvraagt. Het adres verlaat het apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobiera stronę, o którą prosi model. Adres opuszcza urządzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa a página que o modelo solicitar. O endereço sai do dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarcă pagina cerută de model. Adresa părăsește dispozitivul."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Laddar ned en sida som modellen ber om. Adressen lämnar enheten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดหน้าที่โมเดลร้องขอ ที่อยู่เว็บจะถูกส่งออกจากอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelin istediği sayfayı indirir. Adres cihazdan dışarı gönderilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажує сторінку, яку запитує модель. Адреса залишає пристрій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải trang mà mô hình yêu cầu. Địa chỉ sẽ được gửi ra khỏi thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载模型请求的网页。网址会离开设备。"
          }
        }
      }
    },
