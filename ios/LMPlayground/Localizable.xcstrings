    "In the Models folder of LM Playground, which you can see in the Files app and in Finder when your device is connected to a Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في مجلد Models الخاص بـ LM Playground، الذي يمكنك رؤيته في تطبيق الملفات وفي Finder عند توصيل جهازك بجهاز Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Playground-এর Models ফোল্ডারে, যা Files অ্যাপে এবং ডিভাইস Mac-এ সংযুক্ত থাকলে Finder-এ দেখা যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve složce Models aplikace LM Playground, kterou uvidíte v aplikaci Soubory a ve Finderu, když je zařízení připojené k Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I mappen Models i LM Playground, som du kan se i appen Arkiver og i Finder, når din enhed er forbundet til en Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Ordner „Models“ von LM Playground, den du in der Dateien-App und im Finder siehst, wenn dein Gerät mit einem Mac verbunden ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la carpeta Models de LM Playground, que puedes ver en la app Archivos y en el Finder cuando tu dispositivo está conectado a un Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Playgroundin Models-kansiossa, jonka näet Tiedostot-appissa ja Finderissa, kun laite on yhdistetty Maciin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Models folder ng LM Playground, na makikita mo sa Files app at sa Finder kapag nakakonekta ang device mo sa isang Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le dossier Models de LM Playground, visible dans l’app Fichiers et dans le Finder lorsque votre appareil est connecté à un Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בתיקייה Models של LM Playground, שאפשר לראות באפליקציית הקבצים וב־Finder כשהמכשיר מחובר ל־Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Playground के Models फ़ोल्डर में, जिसे आप Files ऐप में और डिवाइस को Mac से जोड़ने पर Finder में देख सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di folder Models milik LM Playground, yang dapat dilihat di app File dan di Finder saat perangkat terhubung ke Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella cartella Models di LM Playground, visibile nell’app File e nel Finder quando il dispositivo è collegato a un Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Playground の Models フォルダに保存されます。このフォルダは「ファイル」App や、デバイスを Mac に接続したときの Finder で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Playground의 Models 폴더에 저장됩니다. 이 폴더는 파일 앱과, 기기를 Mac에 연결했을 때 Finder에서 볼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam folder Models LM Playground, yang boleh dilihat dalam apl Fail dan dalam Finder apabila peranti disambungkan ke Mac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I mappen Models i LM Playground, som du ser i Filer-appen og i Finder når enheten er koblet til en Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de map Models van LM Playground, die je ziet in de Bestanden-app en in de Finder als je apparaat met een Mac is verbonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W folderze Models aplikacji LM Playground, widocznym w aplikacji Pliki oraz w Finderze, gdy urządzenie jest podłączone do Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na pasta Models do LM Playground, que você pode ver no app Arquivos e no Finder quando o dispositivo está conectado a um Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În dosarul Models al LM Playground, pe care îl vezi în aplicația Fișiere și în Finder când dispozitivul este conectat la un Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I mappen Models i LM Playground, som du ser i appen Filer och i Finder när enheten är ansluten till en Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในโฟลเดอร์ Models ของ LM Playground ซึ่งดูได้ในแอปไฟล์และใน Finder เมื่ออุปกรณ์เชื่อมต่อกับ Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Playground'un Models klasöründe; bu klasörü Dosyalar uygulamasında ve cihazın bir Mac'e bağlıyken Finder'da görebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У папці Models застосунку LM Playground, яку видно в застосунку «Файли» та у Finder, коли пристрій під’єднано до Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong thư mục Models của LM Playground, bạn có thể thấy thư mục này trong ứng dụng Tệp và trong Finder khi thiết bị kết nối với máy Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在 LM Playground 的 Models 文件夹中，你可以在“文件”App 中看到它，设备连接到 Mac 时也能在“访达”中看到。"
          }
        }
      }
    },
