        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुझे कितनी स्टोरेज जगह चाहिए?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa ruang penyimpanan yang saya butuhkan?"
          }
        },
        "it": {
