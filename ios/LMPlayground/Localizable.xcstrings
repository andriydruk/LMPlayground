      }
    },
    "This is a vision module (mmproj). Import the model it belongs to; the module is picked up automatically when it sits next to it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه وحدة رؤية (mmproj). استورد النموذج الذي تنتمي إليه؛ تُكتشف الوحدة تلقائيًا عندما تكون بجانبه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি একটি ভিশন মডিউল (mmproj)। যে মডেলের অংশ সেটি ইমপোর্ট করুন; মডিউলটি তার পাশে থাকলে স্বয়ংক্রিয়ভাবে শনাক্ত হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je vizuální modul (mmproj). Importujte model, ke kterému patří; modul se načte automaticky, pokud leží vedle něj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er et billedmodul (mmproj). Importér den model, det hører til; modulet findes automatisk, når det ligger ved siden af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein Bildmodul (mmproj). Importiere das zugehörige Modell – das Modul wird automatisch erkannt, wenn es daneben liegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es un módulo de visión (mmproj). Importa el modelo al que pertenece; el módulo se detecta automáticamente si está junto a él."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on kuvamoduuli (mmproj). Tuo malli, johon se kuuluu; moduuli tunnistetaan automaattisesti, kun se on mallin vieressä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isa itong vision module (mmproj). I-import ang modelong kinabibilangan nito; awtomatikong makikilala ang module kapag katabi ito ng modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est un module de vision (mmproj). Importez le modèle auquel il appartient ; le module est détecté automatiquement lorsqu’il se trouve à côté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהו מודול ראייה (mmproj). ייבאו את המודל שאליו הוא שייך; המודול מזוהה אוטומטית כשהוא נמצא לידו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह विज़न मॉड्यूल (mmproj) है। जिस मॉडल का यह हिस्सा है उसे इंपोर्ट करें; मॉड्यूल उसके पास होने पर अपने-आप पहचाना जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah modul visi (mmproj). Impor model pemiliknya; modul akan dikenali otomatis jika berada di sebelahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è un modulo di visione (mmproj). Importa il modello a cui appartiene; il modulo viene rilevato automaticamente se si trova accanto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは画像モジュール（mmproj）です。対応するモデルを読み込んでください。モジュールは同じ場所にあれば自動的に認識されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 비전 모듈(mmproj)입니다. 해당 모델을 가져오세요. 모듈이 같은 위치에 있으면 자동으로 인식됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini ialah modul penglihatan (mmproj). Import model pemiliknya; modul akan dikesan secara automatik jika berada di sebelahnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en bildemodul (mmproj). Importer modellen den hører til; modulen blir funnet automatisk når den ligger ved siden av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een beeldmodule (mmproj). Importeer het model waar hij bij hoort; de module wordt automatisch herkend als hij ernaast staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To moduł wizyjny (mmproj). Zaimportuj model, do którego należy; moduł zostanie wykryty automatycznie, jeśli leży obok niego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um módulo de visão (mmproj). Importe o modelo a que ele pertence; o módulo é detectado automaticamente quando fica ao lado dele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta este un modul de viziune (mmproj). Importă modelul căruia îi aparține; modulul este detectat automat când se află lângă el."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är en bildmodul (mmproj). Importera modellen den hör till; modulen hittas automatiskt när den ligger bredvid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือโมดูลการมองเห็น (mmproj) ให้นำเข้าโมเดลที่โมดูลนี้เป็นของ โมดูลจะถูกตรวจพบโดยอัตโนมัติเมื่ออยู่ข้างโมเดล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir görüntü modülü (mmproj). Ait olduğu modeli içe aktar; modül, modelin yanında durduğunda otomatik olarak algılanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це модуль зору (mmproj). Імпортуйте модель, до якої він належить; модуль підхоплюється автоматично, якщо лежить поруч із нею."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là mô-đun thị giác (mmproj). Hãy nhập mô hình mà nó thuộc về; mô-đun sẽ được nhận tự động khi nằm cạnh mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是视觉模块（mmproj）。请导入它所属的模型；模块与模型放在一起时会被自动识别。"
          }
        }
      }
    },
    "This model has no chat template, so it can't be used for chat.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا النموذج على قالب محادثة، لذا لا يمكن استخدامه للمحادثة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মডেলের কোনো চ্যাট টেমপ্লেট নেই, তাই এটি কথোপকথনে ব্যবহার করা যাবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento model nemá šablonu konverzace, takže ho nelze použít ke konverzaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne model har ingen chatskabelon, så den kan ikke bruges til chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell hat keine Chatvorlage und kann daher nicht zum Chatten verwendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo no tiene plantilla de chat, así que no se puede usar para chatear."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä mallilla ei ole keskustelupohjaa, joten sitä ei voi käyttää keskusteluun."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang chat template ang modelong ito, kaya hindi ito magagamit sa chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle n’a pas de modèle de conversation, il ne peut donc pas être utilisé pour discuter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למודל הזה אין תבנית צ׳אט, ולכן אי אפשר להשתמש בו לשיחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मॉडल में चैट टेम्पलेट नहीं है, इसलिए इसे बातचीत के लिए इस्तेमाल नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ini tidak memiliki template obrolan, jadi tidak dapat dipakai untuk mengobrol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo modello non ha un template di chat, quindi non può essere usato per chattare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルにはチャットテンプレートがないため、チャットには使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델에는 채팅 템플릿이 없어 대화에 사용할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ini tiada templat sembang, jadi tidak boleh digunakan untuk bersembang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne modellen har ingen chatmal, så den kan ikke brukes til chat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit model heeft geen chatsjabloon en kan dus niet worden gebruikt om te chatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten model nie ma szablonu czatu, więc nie można go używać do rozmów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo não tem modelo de chat, então não pode ser usado para conversar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest model nu are șablon de chat, așa că nu poate fi folosit pentru conversații."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här modellen saknar chattmall och kan därför inte användas för chatt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลนี้ไม่มีเทมเพลตแชต จึงใช้แชตไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu modelin sohbet şablonu yok, bu yüzden sohbet için kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця модель не має шаблону чату, тому її не можна використовувати для розмов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình này không có mẫu trò chuyện nên không thể dùng để trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型没有对话模板，因此无法用于对话。"
          }
        }
      }
    },
    "This model needs about %lld MB of memory, but only %lld MB is available. Try a smaller context size or a smaller model.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج هذا النموذج إلى نحو %1$lld ميغابايت من الذاكرة، لكن المتاح %2$lld ميغابايت فقط. جرّب حجم سياق أصغر أو نموذجًا أصغر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মডেলের প্রায় %1$lld MB মেমরি দরকার, কিন্তু মাত্র %2$lld MB উপলব্ধ। ছোট কনটেক্সট আকার বা ছোট মডেল চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento model potřebuje asi %1$lld MB paměti, ale k dispozici je jen %2$lld MB. Zkuste menší kontext nebo menší model."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
