            "value": "どのくらいのストレージ容量が必要ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간은 얼마나 필요한가요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak ruang storan yang saya perlukan?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mye lagringsplass trenger jeg?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel opslagruimte heb ik nodig?"
          }
        },
        "pl": {
          "stringUnit": {
