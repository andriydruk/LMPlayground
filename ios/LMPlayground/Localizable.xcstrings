    "A gentle tick as each part of the response streams in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نبضة خفيفة مع تدفق كل جزء من الرد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিক্রিয়ার প্রতিটি অংশ স্ট্রিম হওয়ার সাথে একটি মৃদু কম্পন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemné cuknutí při příchodu každé části odpovědi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et blidt tik, efterhånden som hver del af svaret kommer ind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanftes Ticken, während jeder Teil der Antwort eintrifft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una suave vibración a medida que cada parte de la respuesta va llegando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kevyt naps, kun jokainen vastauksen osa saapuu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Banayad na tick habang dumarating ang bawat bahagi ng tugon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une légère vibration à mesure que chaque partie de la réponse arrive."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רטט עדין עם הזרמת כל חלק של התגובה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब का हर हिस्सा स्ट्रीम होते ही एक हल्की कंपन।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Getaran halus saat setiap bagian respons mengalir masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una leggera vibrazione mentre ogni parte della risposta arriva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答の各部分がストリーミングされるたびに、やさしく振動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답의 각 부분이 스트리밍될 때 부드러운 진동을 전달합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Getaran halus apabila setiap bahagian respons dialirkan masuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et mykt napp etter hvert som hver del av svaret kommer inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zachte tik terwijl elk deel van het antwoord binnenkomt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatne puknięcie przy każdej części spływającej odpowiedzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vibração suave conforme cada parte da resposta chega."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O vibrație ușoară pe măsură ce fiecare parte a răspunsului sosește."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En mjuk vibration när varje del av svaret kommer in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสั่นเบาๆ ขณะที่แต่ละส่วนของคำตอบสตรีมเข้ามา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtın her parçası akış halinde geldikçe hafif bir titreşim verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Легке посмикування під час надходження кожної частини відповіді."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một nhịp rung nhẹ khi từng phần phản hồi được truyền về."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复的每个部分流式输出时，伴随轻柔的振动。"
          }
        }
      }
    },
