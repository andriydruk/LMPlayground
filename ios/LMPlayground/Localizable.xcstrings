    "Save a persona, tone or output format once and use it with any model.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ شخصية أو نبرة أو تنسيق إخراج مرة واحدة واستخدمه مع أي نموذج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবার একটি পারসোনা, ভঙ্গি বা আউটপুট ফরম্যাট সংরক্ষণ করুন এবং যেকোনো মডেলে ব্যবহার করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte si personu, tón nebo formát výstupu jednou a používejte je s libovolným modelem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem en persona, tone eller et outputformat én gang, og brug det med enhver model."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere eine Persona, einen Ton oder ein Ausgabeformat einmal und nutze es mit jedem Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un personaje, un tono o un formato de salida una vez y úsalo con cualquier modelo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna persoona, sävy tai tulostemuoto kerran ja käytä sitä minkä tahansa mallin kanssa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-save nang isang beses ang isang persona, tono o format ng output at gamitin ito sa kahit anong modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une fois un personnage, un ton ou un format de sortie et utilisez-le avec n’importe quel modèle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו פרסונה, טון או פורמט פלט פעם אחת והשתמשו בהם עם כל מודל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार कोई पर्सोना, लहजा या आउटपुट फ़ॉर्मैट सेव करें और किसी भी मॉडल के साथ इस्तेमाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan persona, gaya bahasa, atau format keluaran sekali dan gunakan dengan model apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una volta un personaggio, un tono o un formato di output e usalo con qualsiasi modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペルソナ、口調、出力形式を一度保存すれば、どのモデルでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페르소나, 어조, 출력 형식을 한 번 저장해 두고 어떤 모델에서든 사용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan persona, nada atau format output sekali dan gunakannya dengan mana-mana model."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre en persona, tone eller et utdataformat én gang, og bruk det med hvilken som helst modell."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla een persona, toon of uitvoerformaat één keer op en gebruik het met elk model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz raz personę, ton lub format odpowiedzi i używaj z dowolnym modelem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve uma persona, um tom ou um formato de saída uma vez e use com qualquer modelo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează o dată un personaj, un ton sau un format de răspuns și folosește-l cu orice model."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara en persona, ton eller ett utdataformat en gång och använd det med vilken modell som helst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกบุคลิก น้ำเสียง หรือรูปแบบผลลัพธ์ครั้งเดียว แล้วใช้กับโมเดลใดก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kişiliği, üslubu veya çıktı biçimini bir kez kaydet ve her modelle kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть персонажа, тон або формат відповіді один раз і використовуйте з будь-якою моделлю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu một vai trò, giọng điệu hoặc định dạng đầu ra một lần và dùng với mọi mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存一次角色、语气或输出格式，即可在任何模型中使用。"
          }
        }
      }
    },
