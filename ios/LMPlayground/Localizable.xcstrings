    "Go to Settings, then Models. Swipe left on a downloaded model and tap Delete.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل إلى الإعدادات ثم النماذج. اسحب لليسار على نموذج منزّل واضغط على حذف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংসে যান, তারপর মডেলে। ডাউনলোড করা মডেলের ওপর বাঁ দিকে সোয়াইপ করে মুছে ফেলুন-এ ট্যাপ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete Nastavení a pak Modely. Přejeďte po staženém modelu doleva a klepněte na Smazat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå til Indstillinger og derefter Modeller. Stryg til venstre på en downloadet model, og tryk på Slet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Einstellungen und dann Modelle. Wische auf einem heruntergeladenen Modell nach links und tippe auf „Löschen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a Ajustes y luego a Modelos. Desliza a la izquierda sobre un modelo descargado y toca Eliminar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Asetukset ja sitten Mallit. Pyyhkäise ladatun mallin kohdalla vasemmalle ja napauta Poista."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumunta sa Settings, tapos sa Mga Modelo. Mag-swipe pakaliwa sa na-download na modelo at i-tap ang Tanggalin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans Paramètres, puis Modèles. Balayez vers la gauche un modèle téléchargé et touchez Supprimer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עברו להגדרות ואז למודלים. החליקו שמאלה על מודל שהורד והקישו על מחיקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स में जाएँ, फिर मॉडल में। डाउनलोड किए गए मॉडल पर बाईं ओर स्वाइप करें और डिलीट करें पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Pengaturan, lalu Model. Geser ke kiri pada model yang sudah diunduh, lalu ketuk Hapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai in Impostazioni, poi Modelli. Scorri verso sinistra su un modello scaricato e tocca Elimina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 → モデルを開き、ダウンロード済みのモデルを左にスワイプして「削除」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → 모델로 이동한 다음, 다운로드한 모델을 왼쪽으로 쓸어넘기고 삭제를 탭하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergi ke Tetapan, kemudian Model. Leret ke kiri pada model yang dimuat turun dan ketik Padam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå til Innstillinger og deretter Modeller. Sveip mot venstre på en nedlastet modell og trykk på Slett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga naar Instellingen en dan Modellen. Veeg naar links over een gedownload model en tik op Verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź do Ustawień, a następnie Modeli. Przesuń palcem w lewo po pobranym modelu i stuknij Usuń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vá em Configurações e depois em Modelos. Deslize para a esquerda em um modelo baixado e toque em Excluir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mergi la Setări, apoi la Modele. Glisează spre stânga pe un model descărcat și atinge Șterge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå till Inställningar och sedan Modeller. Svep åt vänster på en nedladdad modell och tryck på Ta bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปที่ การตั้งค่า แล้วไปที่ โมเดล ปัดซ้ายที่โมเดลที่ดาวน์โหลดแล้วแตะ ลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'a, ardından Modeller'e git. İndirilmiş bir modelde sola kaydır ve Sil'e dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Налаштування, потім Моделі. Проведіть ліворуч по завантаженій моделі й торкніться «Видалити»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vào Cài đặt, rồi Mô hình. Vuốt sang trái trên mô hình đã tải và chạm vào Xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“设置”→“模型”，在已下载的模型上向左轻扫，然后轻点“删除”。"
          }
        }
      }
    },
