    "This is a speech-recognition model, not a chat model.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا نموذج تعرّف على الكلام، وليس نموذج محادثة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি একটি স্পিচ-রিকগনিশন মডেল, চ্যাট মডেল নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je model rozpoznávání řeči, ne konverzační model."
          }
        },
        "da": {
